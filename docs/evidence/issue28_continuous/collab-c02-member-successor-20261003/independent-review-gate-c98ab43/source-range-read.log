31: 
32: def _write(path,value):normal._write(path,normal._bytes(value))
33: 
34: 
35: def _record(path,body):
36:     value={**body,'record_id':content_hash(value=body)};_write(path,value);return value
37: 
38: 
39: def _read(path):
40:     _need(first_symlink_in_path(path=path) is None,'UPDATE_STATE_PATH_ALIAS')
41:     value=strict_json_file(path=path)
42:     _need(value['record_id']==content_hash(value={k:v for k,v in value.items() if k!='record_id'}),'UPDATE_RECORD_CHANGED')
43:     return value
44: 
45: 
46: @contextmanager
47: def _locked(root):
48:     _need(first_symlink_in_path(path=root) is None,'UPDATE_STATE_PATH_ALIAS')
49:     root.mkdir(parents=True,exist_ok=True);path=root/'update.lock'
50:     _need(first_symlink_in_path(path=path) is None,'UPDATE_STATE_PATH_ALIAS')
51:     with path.open('a+b') as handle:
52:         try:fcntl.flock(handle.fileno(),fcntl.LOCK_EX|fcntl.LOCK_NB)
53:         except BlockingIOError as error:raise OrdinaryUpdateError('UPDATE_ALREADY_RUNNING') from error
54:         yield

309: def _install_case_inputs(*, data_root, source_root, company_id, case, requirement, extra_input_bytes=None):
310:     """Shared immutable runtime/source installation for explicit native routes."""
311:     verify_ordinary_source_proofs(data_root=source_root,proofs=case["source_proofs"])
312:     from .ordinary_source_authority import checkpoint_installation,EXPORT_PATH
313:     checkpoint,extra_source_paths = checkpoint_installation(source_root=source_root)
314:     from .annual_runtime import _authority_files
315:     from .annual_continuity_sources import frozen_foundation_receipts
316:     paths = set(_authority_files(requirement))
317:     cursor = requirement
318:     while cursor:
319:         paths.update(cursor.get("execution_authority",{}).get("files",{}))
320:         paths.update(cursor.get("baseline",{}).get("new_rule_files",{}))
321:         cursor = cursor.get("parent_snapshot")
322:     paths.update(str(p.relative_to(ROOT)) for p in (ROOT/"requirements").rglob("*") if p.is_file())
323:     parent_index = strict_json_file(path=ROOT/"docs/evidence/issue28_continuous/frozen-parent-v10-index.json")
324:     paths.update("docs/evidence/issue28_continuous/frozen-parent-v10/"+p for p in parent_index["files"])
325:     source_paths = {"config/company_registry.csv","evidence/requests_log.csv","evidence/requests_log_manifest.json",*extra_source_paths}
326:     for proof in case["source_proofs"]:
327:         source_paths.update([proof["request_repo_relative_path"],proof["request_headers_repo_relative_path"]])
328:     # Event completeness also compares the authenticated acquisition census.
329:     # Header bytes used by that census are bound original inputs, not answers.
330:     if case["primary_metric_id"] in {"C01","E01","E02","E03","E04","E05"}:
331:         from .traits import repository_company_ciks
332:         ciks = {int(cik) for cik in repository_company_ciks(repo_root=source_root,company_id=company_id)}
333:         for directory in (source_root/"evidence/accession_materials").iterdir():
334:             fields = directory.name.rsplit("_",2)
335:             if directory.is_dir() and len(fields)==3 and fields[1].isdigit() and int(fields[1]) in ciks:
336:                 source_paths.update(str(p.relative_to(source_root)) for p in directory.glob("*.hdr.sgml"))
337:     _need(not source_paths.intersection(_policy(ROOT)["rule_paths"]+_policy(ROOT)["presentation_paths"]),
338:           "ORDINARY_INTEGRATED_SOURCE_WOULD_REPLACE_RUNTIME")
339:     receipts = frozen_foundation_receipts()
340:     for relative in sorted(paths|source_paths):
341:         source = resolve_repository_file(repo_root=source_root if relative in source_paths else ROOT,repo_relative_path=relative)
342:         _write(data_root/relative,receipts[relative]["bytes"] if relative in receipts else source.read_bytes())
343:     if checkpoint is not None:_write(data_root/EXPORT_PATH,_bytes(checkpoint))
344:     for relative, raw in (extra_input_bytes or {}).items():
345:         _need(relative not in paths|source_paths and not Path(relative).is_absolute()
346:               and '..' not in Path(relative).parts, 'ORDINARY_EXTRA_INPUT_WOULD_REPLACE_RUNTIME')
347:         _write(data_root/relative,raw)

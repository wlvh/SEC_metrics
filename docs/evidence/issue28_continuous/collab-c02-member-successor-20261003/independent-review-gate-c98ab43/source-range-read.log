309: def run_once(*,state_root,source_root,company_id,metric_ids,native_assessment_mode='LIVE',native_assessment_ledger=None,
310:              source_identity_root=None,a05_formula=False,d02_category=False,
311:              c02_auditor_revision=False, c02_member_revision=False):
312:     """Check one company's current input and keep a durable candidate history."""
313:     _need(type(d02_category) is bool or d02_category == 'ITEM8_V2',
314:           'UPDATE_D02_CATEGORY_SCOPE_INVALID')
315:     _need(d02_category is not True, 'UPDATE_D02_CATEGORY_RULE_VALIDATION_SUSPENDED')
316:     _need(d02_category != 'ITEM8_V2', 'UPDATE_D02_V2_CATEGORY_RULE_VALIDATION_SUSPENDED')
317:     _need(type(c02_auditor_revision) is bool and (not c02_auditor_revision or
318:           metric_ids == ['C02']), 'UPDATE_C02_AUDITOR_REVISION_SCOPE_INVALID')
319:     _need(type(c02_member_revision) is bool and (not c02_member_revision or
320:           c02_auditor_revision), 'UPDATE_C02_MEMBER_REVISION_SCOPE_INVALID')
321:     _need(not c02_member_revision, 'UPDATE_C02_MEMBER_RULE_VALIDATION_SUSPENDED')
322:     root=normal._external(Path(state_root));source=(normal._external(Path(source_root))
323:         if source_identity_root is not None else Path(source_root).resolve())
324:     identity_source=(source if source_identity_root is None else
325:                      normal._external(Path(source_identity_root)))
326:     _need(root!=source and root not in source.parents and source not in root.parents,'UPDATE_SOURCE_STATE_ROOTS_OVERLAP')
327:     if source_identity_root is not None:
328:         from .ordinary_processing_source import verify_processing_source
329:         from .continuous_call_policy import REQUIREMENT_ID
330:         processing_requirement=load_requirement_snapshot(
331:             snapshot_dir=normal.ROOT/'requirements'/REQUIREMENT_ID)
332:         verify_processing_source(acquisition_root=identity_source,
333:             processing_root=source,requirement=processing_requirement)
334:     with _locked(root):
335:         configuration=_config(root,identity_source,company_id,metric_ids,
336:                               native_assessment_mode,a05_formula,d02_category,
337:                               c02_auditor_revision=c02_auditor_revision,
338:                               c02_member_revision=c02_member_revision)
339:         state=_recover(root,_state(root,configuration),configuration)
340:         previous=None;successful_results={}
341:         if state['successful_attempt'] is not None:
342:             previous=_terminal(root,state['successful_attempt']);successful_results=_verify_candidate(root,previous,configuration)
343:         identity=uuid4().hex;work=_attempt(root,identity)
344:         intent=_record(work/'intent.json',{'record_type':'ORDINARY_UPDATE_INTENT','attempt_id':identity,
345:             'configuration_id':configuration['record_id'],'started_at':_now(),'previous_attempt':state['latest_attempt'],
346:             'previous_successful_attempt':state['successful_attempt']})
347:         descriptor=None;metrics={};status='INPUT_FAILED';error=None
348:         try:
349:             _,descriptor,ledger=_inspect(source,configuration,native_assessment_ledger)
350:             if previous:
351:                 _need(all(descriptor['targets'][m]['period_end']>=previous['input']['targets'][m]['period_end']
352:                           for m in configuration['metric_ids']),'UPDATE_SOURCE_PERIOD_REGRESSED')
353:             if previous and descriptor==previous['input']:
354:                 status='NO_SOURCE_CONTENT_CHANGE'
355:             elif state['latest_attempt'] and (prior:=_terminal(root,state['latest_attempt']))['status'] in {'CANDIDATE_WITHHELD','PREVIOUS_INPUT_WITHHELD'} and prior['input']==descriptor:
356:                 status='PREVIOUS_INPUT_WITHHELD'
357:             else:
358:                 for metric in configuration['metric_ids']:
359:                     normal.install_normal_inputs(data_root=work/'data',source_root=None if source==normal.ROOT else source,
360:                         company_id=company_id,metric_id=metric,
361:                         **({'registered_update_options':configuration['registered_update_options'],'native_assessment_ledger':native_assessment_ledger} if 'registered_update_options' in configuration else {}),
362:                         **({'c02_composition':True,'c02_grouped':True,
363:                             'c02_auditor_revision':c02_auditor_revision,
364:                             'c02_member_revision':c02_member_revision} if metric == 'C02' else {}),
365:                         **({'d01_emphasis':True} if metric == 'D01' else {}),
366:                         **({'a05_formula':True} if a05_formula else {}),
367:                         **({'d02_category':d02_category} if d02_category else {}))
368:                     created=normal.create_normal_run(data_root=work/'data',run_dir=work/'runs'/metric,
369:                         company_id=company_id,metric_id=metric,
370:                         **({'c02_composition':True,'c02_grouped':True,
371:                             'c02_auditor_revision':c02_auditor_revision,
372:                             'c02_member_revision':c02_member_revision} if metric == 'C02' else {}),
373:                         **({'d01_emphasis':True} if metric == 'D01' else {}),
374:                         **({'a05_formula':True} if a05_formula else {}),
375:                         **({'d02_category':d02_category} if d02_category else {}))
376:                     rendered=render_ordinary_run(data_root=work/'data',run_dir=work/'runs'/metric)
377:                     hashes={}
378:                     for name,raw in rendered['files'].items():
379:                         path=work/'rows'/metric/name;normal._write(path,raw);hashes[name]=sha256_file(path=path)
380:                     metrics[metric]={'result_id':created['result']['result_id'],'publication':created['result']['publication'],
381:                                      'source_credit':created['input_binding']['source_admission']['source_credit'],'files':hashes}
382:                     if metric in {'B13','D04'}:
383:                         current_case=normal.replay_case(data_root=work/'data',manifest=created['manifest'])
384:                         metrics[metric]['native_assessment_completed'] = _completed_result(metric=metric,
385:                             result=created['result'],case=current_case,rendered=rendered,data_root=work/'data')
386:                 _need(sha256_file(path=source/'evidence/requests_log.csv')==ledger,'UPDATE_SOURCE_CHANGED_DURING_EXECUTION')
387:                 status='CANDIDATE_READY' if all(v['publication']=='PUBLISHED' or v.get('native_assessment_completed') is True for v in metrics.values()) else 'CANDIDATE_WITHHELD'
388:                 if status=='CANDIDATE_READY':
389:                     successful_results=_verify_candidate(root,{'status':status,'configuration_id':configuration['record_id'],
390:                         'attempt_id':identity,'input':descriptor,'metrics':metrics},configuration)
391:             if source_identity_root is not None:
392:                 verify_processing_source(acquisition_root=identity_source,
393:                     processing_root=source,requirement=processing_requirement)
394:         except Exception as failure:
395:             error={'error_type':type(failure).__name__,'reason':str(failure)}
396:             status='EXECUTION_FAILED' if descriptor is not None else 'INPUT_FAILED'
397:         terminal=_record(work/'terminal.json',{'record_type':'ORDINARY_UPDATE_TERMINAL','attempt_id':identity,
398:             'configuration_id':configuration['record_id'],'intent_id':intent['record_id'],'status':status,
399:             'completed_at':_now(),'input':descriptor,'metrics':metrics,'error':error,
400:             'calls':{'provider':0,'paid':0,'sec':0},'production_authorized':False})
401:         if status=='CANDIDATE_READY':
402:             state['successful_attempt']=identity;previous=terminal
403:         state['latest_attempt']=identity;atomic_write_json(path=root/'current.json',value=state)
404:         return {'status':status,'attempt_id':identity,'latest_attempt':identity,
405:             'successful_attempt':state['successful_attempt'],'previous_successful_attempt':intent['previous_successful_attempt'],
406:             'last_verified_candidate':None if previous is None else {
407:                 'attempt_id':previous['attempt_id'],'targets':previous['input']['targets'],
408:                 'current_input_matches':descriptor==previous['input'],'results':successful_results,
409:                 'rows_root':str(_attempt(root,previous['attempt_id'])/'rows')},
410:             'new_candidate_created':bool(metrics),'terminal':terminal,'calls':{'provider':0,'paid':0,'sec':0},'production_authorized':False}
411: 
412: 
413: def run_company(*,state_root,source_root,company_id,metric_ids,native_assessment_mode='LIVE',native_assessment_ledger=None,
414:                 source_identity_root=None):
415:     """Keep each metric's candidate independent of other metric failures."""
416:     root=normal._external(Path(state_root));policy=normal._policy(normal.ROOT)
417:     _need(type(metric_ids) is list and metric_ids and len(metric_ids)==len(set(metric_ids))
418:           and set(metric_ids)<=set(normal.update_metric_ids()),'UPDATE_METRIC_SCOPE_INVALID')
419:     # Earlier group histories remain intact and must use their pinned runtime.
420:     # Never silently start unrelated histories beside an existing group pointer.
421:     _need(not (root/'configuration.json').exists() and not (root/'current.json').exists(),
422:           'UPDATE_GROUP_HISTORY_REQUIRES_PINNED_RUNTIME')
423:     outcomes=[]
424:     for metric in sorted(metric_ids):
425:         try:
426:             outcome=run_once(state_root=root/'metrics'/metric,source_root=source_root,
427:                              company_id=company_id,metric_ids=[metric],native_assessment_mode=native_assessment_mode,
428:                              native_assessment_ledger=native_assessment_ledger,source_identity_root=source_identity_root)
429:         except Exception as error:
430:             outcome={'status':'UPDATE_BLOCKED','error_type':type(error).__name__,'reason':str(error),
431:                      'last_verified_candidate':None,'calls':{'provider':0,'paid':0,'sec':0},'production_authorized':False}
432:         outcomes.append({'metric_id':metric,**outcome})
433:     ready=sum(o['status'] in {'CANDIDATE_READY','NO_SOURCE_CONTENT_CHANGE'} for o in outcomes)
434:     return {'company_id':company_id,'status':'UPDATES_READY' if ready==len(outcomes) else
435:             'UPDATES_PARTIAL' if ready else 'UPDATES_INCOMPLETE','metrics':outcomes,
436:             'calls':{'provider':0,'paid':0,'sec':0},'production_authorized':False}

FILE scripts/vnext/ordinary_c02_member_update_v4.py
1: """Select the explicit #28 C02 member-clause repair on normal updates.
2: 
3: Old C02 journals keep their installed rules. New C02 attempts use a separate
4: successor journal; other metrics retain their current explicit routes.
5: """
6: from pathlib import Path
7: 
8: from . import normal_run_v3 as normal
9: from . import ordinary_update_cycle as current
10: from .ordinary_d02_category_update_v2 import run_company as run_other_metrics
11: 
12: 
13: def run_company(*, state_root, source_root, company_id, metric_ids,
14:                 native_assessment_mode='LIVE', native_assessment_ledger=None,
15:                 source_identity_root=None):
16:     root = normal._external(Path(state_root))
17:     if 'C02' not in metric_ids:
18:         return run_other_metrics(state_root=root, source_root=source_root,
19:             company_id=company_id, metric_ids=metric_ids,
20:             native_assessment_mode=native_assessment_mode,
21:             native_assessment_ledger=native_assessment_ledger,
22:             source_identity_root=source_identity_root)
23:     current._need(type(metric_ids) is list and metric_ids and
24:                   len(metric_ids) == len(set(metric_ids)) and
25:                   set(metric_ids) <= set(normal.update_metric_ids()),
26:                   'UPDATE_METRIC_SCOPE_INVALID')
27:     current._need(not (root/'configuration.json').exists() and
28:                   not (root/'current.json').exists(),
29:                   'UPDATE_GROUP_HISTORY_REQUIRES_PINNED_RUNTIME')
30:     other_ids = [metric for metric in metric_ids if metric != 'C02']
31:     other_rows = (run_other_metrics(state_root=root, source_root=source_root,
32:         company_id=company_id, metric_ids=other_ids,
33:         native_assessment_mode=native_assessment_mode,
34:         native_assessment_ledger=native_assessment_ledger,
35:         source_identity_root=source_identity_root)['metrics'] if other_ids else [])
36:     try:
37:         c02 = current.run_once(state_root=root/'metrics/C02-composition-member-v4',
38:             source_root=source_root, company_id=company_id,
39:             metric_ids=['C02'], native_assessment_mode=native_assessment_mode,
40:             native_assessment_ledger=native_assessment_ledger,
41:             source_identity_root=source_identity_root, c02_auditor_revision=True,
42:             c02_member_revision=True)
43:         c02 = {'metric_id': 'C02', **c02}
44:     except Exception as error:
45:         c02 = {'metric_id': 'C02', 'status': 'UPDATE_BLOCKED',
46:                'error_type': type(error).__name__, 'reason': str(error),
47:                'last_verified_candidate': None,
48:                'calls': {'provider': 0, 'paid': 0, 'sec': 0},
49:                'production_authorized': False}
50:     rows = {row['metric_id']: row for row in [*other_rows, c02]}
51:     ordered = [rows[metric] for metric in metric_ids]
52:     ready = sum(row['status'] in {'CANDIDATE_READY',
53:                                   'NO_SOURCE_CONTENT_CHANGE'} for row in ordered)
54:     return {'company_id': company_id,
55:         'status': 'UPDATES_READY' if ready == len(ordered) else
56:             'UPDATES_PARTIAL' if ready else 'UPDATES_INCOMPLETE',
57:         'metrics': ordered,
58:         'calls': {'provider': 0, 'paid': 0, 'sec': 0},
59:         'production_authorized': False}


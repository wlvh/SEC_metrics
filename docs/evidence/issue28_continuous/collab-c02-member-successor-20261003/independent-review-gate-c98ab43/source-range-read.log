416: def _create_case_run(*, data_root, run_dir, company_id, metric_id, case, requirement, freeze=False):
417:     """One native record/Review/Result write order for ordinary source routes."""
418:     _need(case.get('input_binding', {}).get('c02_selection_policy') != 'COMPOSITION_GROUPED_V4',
419:           'ORDINARY_C02_MEMBER_RULE_VALIDATION_SUSPENDED')
420:     if case.get('input_binding', {}).get('d02_category_policy') is not None:
421:         from .ordinary_d02_item8_v1 import POLICY as suspended_d02_policy
422:         _need(case['input_binding']['d02_category_policy'] != suspended_d02_policy,
423:               'ORDINARY_D02_CATEGORY_RULE_VALIDATION_SUSPENDED')
424:         from .ordinary_d02_item8_v2 import POLICY as suspended_d02_v2_policy
425:         _need(case['input_binding']['d02_category_policy'] != suspended_d02_v2_policy,
426:               'ORDINARY_D02_V2_CATEGORY_RULE_VALIDATION_SUSPENDED')
427:     from .run_store import (create_run,append_run_record,append_review_decision,write_review_assets,
428:         validate_and_freeze_run,load_frozen_run,_mechanically_replay_open_run)
429:     data_root,run_dir = _external(data_root),_external(run_dir)
430:     _need(not run_dir.exists(),"ORDINARY_INTEGRATED_RUN_PATH_EXISTS")
431:     _need(not freeze or _policy(data_root)["freeze_enabled"],"ORDINARY_INTEGRATED_DRAFT_FREEZE_DISABLED")
432:     binding = _binding(case,requirement);key = content_hash(value=binding)[7:]
433:     _write(data_root/BINDING_DIRECTORY/(key+".json"),_bytes(binding))
434:     traits = repository_company_traits(repo_root=data_root,company_id=company_id)
435:     decision,unit,assets = None,None,None
436:     terminal_records = []
437:     if case["kind"] == "TEXT":
438:         api,review_builder = text_api(metric_id,
439:             c02_composition=case['input_binding'].get('c02_selection_policy') == 'COMPOSITION_FACTS_V1')
440:         spec = case["compiled_specs"][metric_id]
441:         candidate = api.create_deterministic_text_candidate(**case["text_arguments"])
442:         evidence = api.build_text_evidence(candidate=candidate,**case["text_arguments"])
443:         unit,assets = review_builder(compiled_spec=spec,candidate=candidate,evidence_check=evidence,
444:                                     source_bindings=case["text_arguments"]["source_references"])
445:         from .review import create_system_review_decision
446:         decision = create_system_review_decision(review_unit=unit,required_claims=spec["compiled"]["required_claims"],
447:             decided_at_utc=datetime.now(timezone.utc).isoformat(),requirement=requirement)
448:         result,trace,observations = api.replay_text_result(company_traits=traits,candidate=candidate,evidence_check=evidence,
449:             review_unit=unit,review_decisions=[decision],**case["text_arguments"])
450:         records = [*case["expected_records"],candidate,evidence,unit]
451:         terminal_records = [*observations,trace,result]
452:     else:
453:         records = case["expected_records"];result = case["results"][metric_id]
454:     create_run(run_dir=run_dir,run_id=PREFIX+key,company_id=company_id,company_traits=traits,
455:         target_period=case["target_period"],source_references=case["references"],missing_required_source_roles=[],
456:         spec_file_hashes={p:sha256_file(path=data_root/p) for p in case["spec_paths"].values()},
457:         requirement_hashes=requirement["hashes"],requirement_id=requirement['requirement_id'],
458:         requirement_closure_hash=requirement["requirement_closure_hash"],artifact_requirement_generation="EXPLICIT_REQUIREMENT_V1")
459:     seen = {}
460:     for record in records:
461:         identity = content_hash(value=record)
462:         _need(identity not in seen or seen[identity] == record,"ORDINARY_INTEGRATED_RECORD_COLLISION")
463:         if identity not in seen:
464:             append_run_record(run_dir=run_dir,record=record);seen[identity] = record
465:     if decision:
466:         write_review_assets(run_dir=run_dir,review_unit=unit,review_context_bytes=assets["review_context_bytes"],
467:                             rendered_review_bytes=assets["rendered_review_bytes"])
468:         append_review_decision(run_dir=run_dir,decision=decision)
469:     for record in terminal_records:
470:         append_run_record(run_dir=run_dir,record=record)
471:     if freeze:
472:         validate_and_freeze_run(run_dir=run_dir,repo_root=data_root)
473:         manifest,stored,_ = load_frozen_run(run_dir=run_dir,repo_root=data_root)
474:     else:
475:         manifest,stored,_ = _mechanically_replay_open_run(run_dir=run_dir,repo_root=data_root,require_complete_results=True)
476:     _need(result in stored,"ORDINARY_INTEGRATED_RESULT_CHANGED")
477:     return {"manifest":manifest,"result":result,"input_binding":binding,"selection":case.get("selection"),
478:             "new_calls":{"provider":0,"paid":0,"sec":0},"production_authorized":False}

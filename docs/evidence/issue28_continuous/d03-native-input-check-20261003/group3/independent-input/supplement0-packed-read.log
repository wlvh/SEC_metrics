{"source_index":0,"content":{"attributes":{"arcrole":"http://www.xbrl.org/2003/arcrole/fact-footnote","fromrefs":"f-76 f-77 f-78 f-94 f-95 f-96 f-112 f-113 f-114","linkrole":"http://www.xbrl.org/2003/role/link","order":"1","torefs":"fn-1"},"end_character":130012,"local_name":"relationship","namespace":"http://www.xbrl.org/2013/inlineXBRL","namespace_environment_id":"sha256:2063b97c2889de88d2c8e0474ee1aeaabd277301b092cfc8b232678f06a6d87c","nested_objects":[],"raw_xml":"<ix:relationship arcrole=\"http://www.xbrl.org/2003/arcrole/fact-footnote\" fromRefs=\"f-76 f-77 f-78 f-94 f-95 f-96 f-112 f-113 f-114\" linkRole=\"http://www.xbrl.org/2003/role/link\" toRefs=\"fn-1\" order=\"1\"/>","raw_xml_sha256":"801d91c5ebc1906a0e7f980b28fd32a7fa5aa637539bcb56d90c817a3dc6e28a","start_character":129808}}
{"source_index":1,"content":{"attributes":{"arcrole":"http://www.xbrl.org/2003/arcrole/fact-footnote","fromrefs":"f-82 f-83 f-84 f-88 f-89 f-90","linkrole":"http://www.xbrl.org/2003/role/link","order":"2","torefs":"fn-2"},"end_character":130198,"local_name":"relationship","namespace":"http://www.xbrl.org/2013/inlineXBRL","namespace_environment_id":"sha256:2063b97c2889de88d2c8e0474ee1aeaabd277301b092cfc8b232678f06a6d87c","nested_objects":[],"raw_xml":"<ix:relationship arcrole=\"http://www.xbrl.org/2003/arcrole/fact-footnote\" fromRefs=\"f-82 f-83 f-84 f-88 f-89 f-90\" linkRole=\"http://www.xbrl.org/2003/role/link\" toRefs=\"fn-2\" order=\"2\"/>","raw_xml_sha256":"cfaaf2d7e5f78b0f66e77c8ed515733c0cab751b15134a8d9c23d53ddb4c87f3","start_character":130012}}
{"source_index":2,"content":{"attributes":{"arcrole":"http://www.xbrl.org/2003/arcrole/fact-footnote","fromrefs":"f-294 f-295 f-296 f-297 f-298 f-299","linkrole":"http://www.xbrl.org/2003/role/link","order":"3","torefs":"fn-3"},"end_character":130390,"local_name":"relationship","namespace":"http://www.xbrl.org/2013/inlineXBRL","namespace_environment_id":"sha256:2063b97c2889de88d2c8e0474ee1aeaabd277301b092cfc8b232678f06a6d87c","nested_objects":[],"raw_xml":"<ix:relationship arcrole=\"http://www.xbrl.org/2003/arcrole/fact-footnote\" fromRefs=\"f-294 f-295 f-296 f-297 f-298 f-299\" linkRole=\"http://www.xbrl.org/2003/role/link\" toRefs=\"fn-3\" order=\"3\"/>","raw_xml_sha256":"5e3e32850e423aec41ba61b9bd33424fa3eca5d67dc06f32768a9164b02161b1","start_character":130198}}

ings per share</span></td><td colspan="2" data-b13-style-ref="34"><span data-b13-style-ref="54"><ix:nonFraction unitRef="shares" contextRef="c-1" decimals="-5" name="us-gaap:WeightedAverageNumberOfDilutedSharesOutstanding" scale="6" id="f-464">273.6</ix:nonFraction>&#160;</span></td><td data-b13-style-ref="36"/><td colspan="3" style="background-color:#ffffff;padding:0 1pt"/><td colspan="2" data-b13-style-ref="34"><span data-b13-style-ref="54"><ix:nonFraction unitRef="shares" contextRef="c-22" decimals="-5" name="us-gaap:WeightedAverageNumberOfDilutedSharesOutstanding" scale="6" id="f-465">285.2</ix:nonFraction>&#160;</span></td><td data-b13-style-ref="36"/><td colspan="3" style="background-color:#ffffff;padding:0 1pt"/><td colspan="2" data-b13-style-ref="34"><span data-b13-style-ref="54"><ix:nonFraction unitRef="shares" contextRef="c-23" decimals="-5" name="us-gaap:WeightedAverageNumberOfDilutedSharesOutstanding" scale="6" id="f-466">302.9</ix:nonFraction>&#160;</span></td><td data-b13-style-ref="36"/></tr><tr><td colspan="3" data-b13-style-ref="20"><div style="padding-left:18pt"><span data-b13-style-ref="54">Diluted earnings per share</span></div></td><td data-b13-style-ref="0"><span data-b13-style-ref="54">$</span></td><td data-b13-style-ref="1"><span data-b13-style-ref="54"><ix:nonFraction unitRef="usdPerShare" contextRef="c-1" decimals="2" name="us-gaap:EarningsPerShareDiluted" scale="0" id="f-467">9.51</ix:nonFraction>&#160;</span></td><td data-b13-style-ref="2"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td data-b13-style-ref="0"><span data-b13-style-ref="54">$</span></td><td data-b13-style-ref="1"><span data-b13-style-ref="54"><ix:nonFraction unitRef="usdPerShare" contextRef="c-22" decimals="2" name="us-gaap:EarningsPerShareDiluted" scale="0" id="f-468">8.33</ix:nonFraction>&#160;</span></td><td data-b13-style-ref="2"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td data-b13-style-ref="0"><span data-b13-style-ref="54"
            "text_payload": {
              "approval_effect_hash": "sha256:ef5ec609d3dfba73e15e237116f84cfd90c2200530c5942ae9d50802651efa85",
              "candidate_hash": "sha256:fbc9da8fee6dbe9ff18288694fdf458dc0bfeaa450711689ed06957769522fb3",
              "content_kind": "SOURCE_EXCERPTS",

166: def _root(directory):
167:     path = Path(directory)
168:     _need(path.is_absolute(), 'ABSOLUTE_OUTPUT_REQUIRED')
169:     _need(first_symlink_in_path(path=path) is None, 'OUTPUT_ALIAS')
170:     path = path.resolve()
171:     ledger = Path(strict_json_file(path=ROOT/
172:         'config/issue28_continuous_calls_v1.json')['budget_root']).resolve()
173:     _need(path != ledger and ledger not in path.parents and path not in ledger.parents, 'LIVE_LEDGER_OUTPUT')
174:     _need(path != ROOT and ROOT not in path.parents and path not in ROOT.parents
175:           and not any((p/'outputs/active_publication.json').exists() for p in (path, *path.parents)),
176:           'OUTSIDE_CODE_AND_PUBLICATION_REQUIRED')
177:     return path

180: def save_table_development_assessment(*, directory, **arguments):
181:     root = _root(directory)
182:     data = Path(arguments['data_root']).resolve()
183:     _need(root != data and data not in root.parents and root not in data.parents,
184:           'SOURCE_OUTPUT_OVERLAP')
185:     out = build_table_development_assessment(**arguments)
186:     files = {'request-body.bin': out['request_body'], 'response.bin': out['response_body'],
187:         'processing/c02/table-metadata.json': _bytes(out['processing']),
188:         'review-context.json': out['review_context_bytes'], 'review.md': out['rendered_review_bytes'],
189:         'records.jsonl': b''.join(_bytes(r)+b'\n' for r in out['records'])}
190:     # Immutable resume reuses exact earlier bytes. Records are the final gate.
191:     for name, raw in files.items():
192:         target = root/name
193:         _need(first_symlink_in_path(path=target) is None, 'OUTPUT_ALIAS')
194:         write_immutable_bytes(path=target, content=raw)
195:     return out
196: 

scripts/vnext/canonical.py
196: def strict_json_file(
197:     *, path: Path, allowed_fields: Optional[Set[str]] = None
198: ) -> object:
199:     """Read one regular UTF-8 file through the strict JSON boundary.
200: 
201:     Args:
202:         path: Input JSON path.
203:         allowed_fields: Optional exact root field set.
204: 
205:     Returns:
206:         Strict parsed JSON.
207: 
208:     Raises:
209:         CanonicalError: When the path is not a regular non-symlink file or its
210:             bytes are not valid UTF-8 strict JSON.
211:     """
212:     if path.is_symlink() or not path.is_file():
213:         raise CanonicalError(
214:             "JSON input must be a regular file: {}".format(path)
215:         )
216:     try:
217:         text = path.read_text(encoding="utf-8")
218:     except UnicodeDecodeError as error:
219:         raise CanonicalError(
220:             "JSON input must be UTF-8: {}".format(path)
221:         ) from error
222:     return strict_json_loads(text=text, allowed_fields=allowed_fields)

scripts/git_workspace.py
71: def first_symlink_in_path(*, path: Path) -> Path | None:
72:     """Return the first symlink in one unresolved lexical path.
73: 
74:     Args:
75:         path: Absolute or relative locator whose components must not redirect.
76: 
77:     Returns:
78:         The first symlink component, or None when every component is direct.
79:     """
80:     current = Path(path.anchor) if path.is_absolute() else Path()
81:     parts = path.parts[1:] if path.is_absolute() else path.parts
82:     # The locator must be inspected before resolve() erases path identity.
83:     for part in parts:
84:         current /= part
85:         if current.is_symlink():
86:             return current
87:     return None

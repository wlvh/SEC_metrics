198: def read_table_development_assessment(*, directory, data_root, company_id,
199:                                     expected_candidate_hash, expected_review_unit_hash):
200:     root = _root(directory)
201:     _need(not any(p.is_symlink() for p in root.rglob('*')), 'OUTPUT_ALIAS')
202:     meta = strict_json_loads(text=(root/'processing/c02/table-metadata.json').read_text())
203:     out = build_table_development_assessment(data_root=data_root, company_id=company_id,
204:         task_text=meta['task_text'], request_body=(root/'request-body.bin').read_bytes(),
205:         response_body=(root/'response.bin').read_bytes(), expected_request_sha256=meta['request_sha256'],
206:         expected_response_sha256=meta['response_sha256'], origin=meta['origin'])
207:     _need(out['records'][2]['candidate_hash'] == expected_candidate_hash
208:           and out['records'][5]['review_unit_hash'] == expected_review_unit_hash, 'EXPECTED_NATIVE_IDENTITIES')
209:     saved = [strict_json_loads(text=line) for line in (root/'records.jsonl').read_text().splitlines()]
210:     _need(out['records'] == saved and meta == out['processing']
211:           and out['review_context_bytes'] == (root/'review-context.json').read_bytes()
212:           and out['rendered_review_bytes'] == (root/'review.md').read_bytes(), 'SAVED_NATIVE_REPLAY_CHANGED')
213:     return out


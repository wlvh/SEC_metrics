    },
    {
      "text": "Chairman and Chief Executive Officer of JPMorgan Chase & Co.",
      "linked": false,
      "emphasized": false,
      "block_index": 767,
      "raw_start_byte": 508415,
      "raw_end_byte": 508479,
      "raw_span_sha256": "a80272ea462dcbb9f475a5f277a8b0bb7c5143389cf8452891b4f32d4cb94cda",
      "raw_utf8": "Chairman and Chief Executive Officer of JPMorgan Chase &amp; Co."
    },
    {
      "text": "Stock Committee: The committee is responsible for implementing the declaration of dividends, authorizing the issuance of stock, administering the dividend reinvestment plan and implementing share repurchase plans. The committee acts within Board-approved limitations and capital plans.",
      "linked": false,
      "emphasized": false,
      "block_index": 1244,
      "raw_start_byte": 788599,
      "raw_end_byte": 789001,
      "raw_span_sha256": "80fbd1d00d3c3f5022feb03943aedbfb9234a90b1c32c77347ce10e8ddd0cf5d",
      "raw_utf8": "Stock Committee: </span><span style=\"color:#000000;font-family:'Sons',sans-serif;font-size:9pt;font-weight:400;line-height:110%\">The committee is responsible for implementing the declaration of dividends, authorizing the issuance of stock, administering the dividend reinvestment plan and implementing share repurchase plans. The committee acts within Board-approved limitations and capital&#160;plans."
    },
    {
      "text": "Executive Committee: The committee may exercise all the powers of the Board that lawfully may be delegated, but with the expectation that it will not take material actions absent special circumstances.",
      "linked": false,
      "emphasized": false,
      "block_index": 1245,
      "raw_start_byte": 789159,
      "raw_end_byte": 789593,
      "raw_span_sha256": "ee7726b3bac1dd4d3bd1ce1ba2bccccfe2942c0d9e38f5a886717c48c4e5cd90",
      "raw_utf8": "Executive Committee:</span><span style=\"color:#000000;font-family:'Sons Semibold',sans-serif;font-size:9pt;font-weight:400;line-height:110%\"> </span><span style=\"color:#000000;font-family:'Sons',sans-serif;font-size:9pt;font-weight:400;line-height:110%\">The committee may exercise all the powers of the Board that lawfully may be delegated, but with the expectation that it will not take material actions absent special circumstances."
    }

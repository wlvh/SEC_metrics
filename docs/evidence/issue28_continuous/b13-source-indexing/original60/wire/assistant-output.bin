{"request_id":"sha256:883818388676d048818810d8d4f4df3963408ced8532d94d84366bf4190c5a65","units":[{"unit_id":"sha256:885e215a010679cf5a16dd0d94e1a6bc49f846b7ac4702b9af3f735136afaf57","reviewed":true,"findings":[{"kind":"CAPACITY_QUALITATIVE","subject":"TARGET_REGISTRANT","timing":"CURRENT_REPORT","evidence":[{"kind":"VISIBLE_BLOCK","source_index":1022}],"reason":"Inventory accounting policy states that capitalization of indirect manufacturing costs is based on the normal utilization of the registrant's manufacturing facility in Texas, and that indirect manufacturing costs related to abnormally low utilization are expensed as incurred. This is a qualitative utilization/capacity accounting policy for the Texas manufacturing facility; no actual production quantity or available capacity figure is stated."}],"unresolved":[],"calculation_limits":["TARGET_CURRENT_PRODUCTION_NOT_PRESENT_IN_THIS_UNIT","TARGET_CURRENT_CAPACITY_NOT_PRESENT_IN_THIS_UNIT"]}]}
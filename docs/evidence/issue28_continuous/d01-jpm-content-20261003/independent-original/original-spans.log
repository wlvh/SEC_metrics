{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%;padding-left:5pt"}, "start": 1532762, "parts": [{"text": "requiring the issuance of, or prohibiting the redemption of, capital instruments in a manner inconsistent with JPMorganChase", "start": 1532886, "end": 1533010, "emphasis": false, "italic": false}, {"text": "&#8217;", "start": 1533010, "end": 1533017, "emphasis": false, "italic": false}, {"text": "s capital management strategy", "start": 1533017, "end": 1533046, "emphasis": false, "italic": false}], "end": 1533053, "text": "requiring the issuance of, or prohibiting the redemption of, capital instruments in a manner inconsistent with JPMorganChase’s capital management strategy"}

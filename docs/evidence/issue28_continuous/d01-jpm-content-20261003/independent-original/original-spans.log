{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%;padding-left:5pt"}, "start": 1434718, "parts": [{"text": "uncertainty concerning the enforceability of intellectual property rights or contractual or other obligations", "start": 1434842, "end": 1434951, "emphasis": false, "italic": false}], "end": 1434958, "text": "uncertainty concerning the enforceability of intellectual property rights or contractual or other obligations"}

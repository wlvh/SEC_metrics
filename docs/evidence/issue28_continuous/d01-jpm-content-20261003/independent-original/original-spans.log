{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%;padding-left:5pt"}, "start": 1621647, "parts": [{"text": "expose JPMorganChase to litigation, investigations by governmental authorities or penalties, or", "start": 1621771, "end": 1621866, "emphasis": false, "italic": false}], "end": 1621873, "text": "expose JPMorganChase to litigation, investigations by governmental authorities or penalties, or"}

{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%;padding-left:5pt"}, "start": 1620459, "parts": [{"text": "harm customers or clients, and cause JPMorganChase to incur associated liabilities ", "start": 1620583, "end": 1620666, "emphasis": false, "italic": false}], "end": 1620673, "text": "harm customers or clients, and cause JPMorganChase to incur associated liabilities"}

{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:700;line-height:120%"}, "start": 1618379, "parts": [{"text": "JPMorganChase could incur losses arising from any significant inadequacy or lapse in its risk management framework and control environment.", "start": 1618486, "end": 1618625, "emphasis": true, "italic": false}], "end": 1618632, "text": "JPMorganChase could incur losses arising from any significant inadequacy or lapse in its risk management framework and control environment."}
{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%"}, "start": 1618669, "parts": [{"text": "JPMorganChase", "start": 1618776, "end": 1618789, "emphasis": false, "italic": false}, {"text": "&#8217;", "start": 1618789, "end": 1618796, "emphasis": false, "italic": false}, {"text": "s financial condition or results of operations could be materially and adversely affected by any significant inadequacy or lapse in its risk management framework, governance structure, practices, models, reporting systems or controls. Any such inadequacy or lapse could:", "start": 1618796, "end": 1619066, "emphasis": false, "italic": false}], "end": 1619073, "text": "JPMorganChase’s financial condition or results of operations could be materially and adversely affected by any significant inadequacy or lapse in its risk management framework, governance structure, practices, models, reporting systems or controls. Any such inadequacy or lapse could:"}
{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%"}, "start": 1619144, "parts": [{"text": "&#8226;", "start": 1619251, "end": 1619258, "emphasis": false, "italic": false}], "end": 1619265, "text": "•"}
{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%;padding-left:5pt"}, "start": 1619265, "parts": [{"text": "lead to inaccurate or delayed identification of risks", "start": 1619389, "end": 1619442, "emphasis": false, "italic": false}], "end": 1619449, "text": "lead to inaccurate or delayed identification of risks"}
{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%"}, "start": 1619520, "parts": [{"text": "&#8226;", "start": 1619627, "end": 1619634, "emphasis": false, "italic": false}], "end": 1619641, "text": "•"}
{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%;padding-left:5pt"}, "start": 1619641, "parts": [{"text": "hinder the timely escalation of material risk issues to JPMorganChase", "start": 1619765, "end": 1619834, "emphasis": false, "italic": false}, {"text": "&#8217;", "start": 1619834, "end": 1619841, "emphasis": false, "italic": false}, {"text": "s senior management and Board of Directors", "start": 1619841, "end": 1619883, "emphasis": false, "italic": false}], "end": 1619890, "text": "hinder the timely escalation of material risk issues to JPMorganChase’s senior management and Board of Directors"}

{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%;padding-left:5pt"}, "start": 1439317, "parts": [{"text": "seek to discourage financial institutions from doing business with companies engaged in certain industries, or conversely, to penalize financial institutions that elect not to do business with such companies, or", "start": 1439441, "end": 1439652, "emphasis": false, "italic": false}], "end": 1439659, "text": "seek to discourage financial institutions from doing business with companies engaged in certain industries, or conversely, to penalize financial institutions that elect not to do business with such companies, or"}
{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%"}, "start": 1439730, "parts": [{"text": "&#8226;", "start": 1439837, "end": 1439844, "emphasis": false, "italic": false}], "end": 1439851, "text": "•"}

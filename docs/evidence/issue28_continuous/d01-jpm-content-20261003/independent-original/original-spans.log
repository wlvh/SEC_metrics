{"tag": "span", "attrs": {"style": "color:#000000;font-family:'Sons',sans-serif;font-size:9.9pt;font-weight:400;line-height:120%;padding-left:5pt"}, "start": 1633581, "parts": [{"text": "cause reputational harm.", "start": 1633705, "end": 1633729, "emphasis": false, "italic": false}], "end": 1633736, "text": "cause reputational harm."}

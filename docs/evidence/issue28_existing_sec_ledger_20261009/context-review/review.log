  assert (case.root/'binding.json').read_bytes()==binding
  for filename in ('intent.json','sec-plan.json','sec-receipt.json'):
   assert 'requirement_closure_hash' not in json.loads((case.root/'calls/0002'/filename).read_text()),filename
 finally:case.doCleanups()


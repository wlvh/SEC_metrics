import ast,json,subprocess
from unittest.mock import patch
from tests.vnext.test_company_online import CompanyOnlineTest
from tests.vnext.test_historical_sec_capture_adapter import HistoricalSecCaptureAdapterTest
from vnext import company_online as online
from vnext.existing_historical_sec_state import inspect_existing_historical_sec

def fixture(kind):
 case=kind();case.setUp();return case

def run(name,body):
 body();print('PASS '+name)

def continuous_positive():
 case=fixture(CompanyOnlineTest)
 try:
  binding=(case.ledger.root/'binding.json').read_bytes();events=[];requirements=[]
  original_claim=case.ledger.claim;original_json=online._atomic_json
  def claim(**kwargs):
   events.append('claim');requirements.append(kwargs['requirement']);return original_claim(**kwargs)
  def save(path,value):
   if path.name=='sec-plan.json':events.append('plan')
   return original_json(path,value)
  def reply(*args,**kwargs):events.append('transport');return (200,b'{}',{},'')
  with patch.object(case.ledger,'claim',side_effect=claim),patch.object(online,'_atomic_json',side_effect=save),patch('vnext.recorded_sec_http.RecordedSecHttpClient.reply',side_effect=reply) as transport:
   case.capture.get(case.url)
  expected={key:case.context[key] for key in ('requirement_id','requirement_closure_hash')}
  assert requirements==[expected],requirements
  intent=json.loads((case.ledger.root/'calls/0001/intent.json').read_text())
  assert all(intent[key]==value for key,value in expected.items())
  assert events==['claim','plan','transport'],events
  assert transport.call_count==1
  with case.ledger.locked():assert case.ledger.snapshot()['counts']==[0,0,1]
  assert (case.ledger.root/'binding.json').read_bytes()==binding
 finally:case.doCleanups()

def continuous_missing_closure():
 case=fixture(CompanyOnlineTest)
 try:
  case.context.pop('requirement_closure_hash');binding=(case.ledger.root/'binding.json').read_bytes()
  with patch.object(case.ledger,'claim',wraps=case.ledger.claim) as claim,patch('vnext.recorded_sec_http.RecordedSecHttpClient.reply',side_effect=AssertionError('No transport')) as transport:
   try:case.capture.get(case.url)
   except KeyError as error:assert error.args==('requirement_closure_hash',)
   else:raise AssertionError('Continuous context must still require closure')
  assert claim.call_count==0 and transport.call_count==0
  with case.ledger.locked():assert case.ledger.snapshot()['counts']==[0,0,0]
  assert (case.ledger.root/'binding.json').read_bytes()==binding
 finally:case.doCleanups()

def historical_no_closure():
 case=fixture(HistoricalSecCaptureAdapterTest)
 try:
  case.context.pop('requirement_closure_hash');binding=(case.root/'binding.json').read_bytes();events=[];requirements=[]
  original_claim=case.ledger.claim;original_json=online._atomic_json
  def claim(**kwargs):
   events.append('claim');requirements.append(kwargs['requirement']);return original_claim(**kwargs)
  def save(path,value):
   if path.name=='sec-plan.json':events.append('plan')
   return original_json(path,value)
  def reply(*args,**kwargs):events.append('transport');return (200,b'{}',{},'')
  with patch.object(case.ledger,'claim',side_effect=claim),patch.object(online,'_atomic_json',side_effect=save),patch('vnext.recorded_sec_http.RecordedSecHttpClient.reply',side_effect=reply) as transport:
   case.capture().get(case.url)
  assert requirements==[{'requirement_id':'issue_47_v1'}],requirements
  assert events==['claim','plan','transport'],events
  assert transport.call_count==1

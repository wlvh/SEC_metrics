+#!/usr/bin/env python3
+"""Run Issue #47's granted model calls, one counted request at a time.
+
+Part of the egress patch: it exists only in a tree where the patch is applied,
+because it calls ``historical_model_egress``. It adds no check of its own that
+the call path does not already make; every request still goes through
+``execute_historical_semantic`` - the allowance, the ledger claim before the
+socket, the stops, no redraw - and every registration through
+``register_from_slots``. What it adds is the loop, and the loop's two rules:
+
+* it stops at the first slot that stopped the channel, and never works around
+  a stop - the next claim would be refused anyway, and saying so by name is
+  better than a traceback;
+* a position is registered only when every one of its requests has a slot
+  that succeeded; a request whose slot failed without a stop cannot be drawn
+  again, so that position is reported incomplete and the others go on.
+
+Commands, in the executor's cloud container that holds the approved ledger
+root (the owner's decision), with the provider key in the environment's
+settings, from a #47 runtime tree carrying both patches:
+
+  register-approval --approval-url URL   read the posted approval back from
+                                         GitHub and write the allowance files
+  start                                  write the ledger's local start record
+                                         and print the marker comment to post
+                                         on issue 47; nothing is called until
+                                         that marker is on GitHub
+  run --position <company>:<report_end> [--position ...]
+                                         call every granted request of each
+                                         position not yet claimed, then
+                                         register each complete position
+  status                                 the ledger's counts, stops and slots
+
+A registered assessment is consumed by the ordinary historical Run; this tool
+builds no Run.
+"""
+import argparse
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+# Before anything of the checkout's is imported: compile it into a private cache
+# this process just made, never reading the checkout's own __pycache__. The call
+# path refuses a socket otherwise (historical_model_calls.loaded_code_holds): an
+# independent review ran changed bytecode beside unchanged sources, and every
+# hash - receipt, approval, controller - still matched, because all hash sources.
+sys.pycache_prefix = tempfile.mkdtemp(prefix="issue47-model-bytecode-")
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from vnext import historical_model_calls as calls  # noqa: E402 - path set above
+from vnext import historical_model_egress as egress  # noqa: E402
+
+
+
+def _position(text):
+    company_id, _, report_end = str(text).rpartition(":")
+    if not company_id or len(report_end) != 10:
+        raise argparse.ArgumentTypeError("POSITION_IS_NOT_COMPANY_COLON_REPORT_END:" + str(text))
+    return company_id, report_end
+
+
+def _slots_by_digest(ledger):
+    """Every claimed slot of this ledger by the request digest it claimed, with its outcome."""
+    slots = {}
+    for slot in sorted((ledger.root / "calls").iterdir()) if (ledger.root / "calls").is_dir() else ():
+        intent = json.loads((slot / "intent.json").read_text(encoding="utf-8"))
+        terminal = slot / "terminal.json"
+        outcome = (json.loads(terminal.read_text(encoding="utf-8")) if terminal.is_file() else None)
+        slots[intent["request_digest"]] = {
+            "slot": slot, "status": None if outcome is None else outcome["status"],
+            "stop_reason": "UNKNOWN_PENDING_RECONCILIATION" if outcome is None
+            else outcome["stop_reason"]}
+    return slots
+
+
+def run_positions(*, positions, metric_id="D04"):
+    """Call and register the granted positions in order; stop at the first stop.
+
+    Returns:
+        A summary: per position, how many requests were called now, found
+        already claimed, and whether the position was registered; the stop, if
+        one ended the run; and the ledger's cumulative counts.
+    """
+    from vnext import invocation_control as control
+    from vnext.canonical import strict_json_loads
+    from vnext.historical_model_calls import ledger_digest
+    from vnext.normal_period_selection import resolve_period_selection
+    allowance, ledger = calls.live_model_ledger()
+    policy = calls.transport_policy(allowance=allowance)
+    authority = control.prepare_successor_invocation_authority(
+        repo_root=ROOT, requirement_id=calls.REQUIREMENT_ID)
+    summary, stop = {}, None
+    for company_id, report_end in positions:
+        calls.request_in_scope(allowance=allowance, metric_id=metric_id, company_id=company_id,
+                               report_end=report_end)
+        selection = resolve_period_selection(repo_root=ROOT, company_id=company_id,
+                                             report_end=report_end)
+        prepared = calls.prepare_historical_requests(
+            company_id=company_id, metric_id=metric_id, period_selection=selection,
+            authority=authority, allowance=allowance, data_root=ROOT)
+        row = {"requests": len(prepared), "called": 0, "already_claimed": 0,
+               "unsuccessful": [], "registered": None}
+        summary[metric_id + ":" + company_id + ":" + report_end] = row
+        for request in prepared:
+            # The digest from the request's own bytes; the call validates the
+            # request against the filing before it claims, so validating here
+            # too would only rebuild the source once more per request.
+            digest = ledger_digest(strict_json_loads(text=request.request_bytes.decode("utf-8")),
+                                   policy)
+            with ledger.locked():
+                ledger.snapshot()
+                claimed = _slots_by_digest(ledger).get(digest)
+            if claimed is None:
+                _, outcome = egress.execute_historical_semantic(prepared=request, ledger=ledger)
+                row["called"] += 1
+                if outcome["stop_reason"]:
+                    stop = (metric_id + ":" + company_id + ":" + report_end + ":"
+                            + outcome["stop_reason"])
+                    break
+            else:
+                row["already_claimed"] += 1
+        if stop is not None:
+            break
+        with ledger.locked():
+            ledger.snapshot()
+            slots = _slots_by_digest(ledger)
+        answered = []
+        for request in prepared:
+            entry = slots[ledger_digest(
+                strict_json_loads(text=request.request_bytes.decode("utf-8")), policy)]
+            if entry["status"] != "SUCCEEDED" or entry["stop_reason"]:
+                row["unsuccessful"].append({"slot": entry["slot"].name, "status": entry["status"]})
+            answered.append(entry["slot"])
+        if not row["unsuccessful"]:
+            record, path = egress.register_from_slots(prepared_requests=prepared, ledger=ledger,
+                                                      slots=answered)
+            row["registered"] = {"input_record_id": record["input_record_id"],
+                                 "path": str(path.relative_to(ROOT)), "mode": record["mode"]}
+    with ledger.locked():
+        state = ledger.snapshot()
+    return {"status": "MODEL_RUN_STOPPED" if stop else "MODEL_RUN_DONE", "stop": stop,
+            "positions": summary, "cumulative_calls": state["counts"],
+            "limits": state["limits"], "stopped": state["stopped"]}
+
+
+def status():
+    allowance, ledger = calls.live_model_ledger()
+    with ledger.locked():
+        state = ledger.snapshot()
+    return {"status": "MODEL_LEDGER", "budget_root": allowance["budget_root"],
+            "cumulative_calls": state["counts"], "limits": state["limits"],
+            "stopped": state["stopped"], "slots": state["rows"]}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("command", choices=["register-approval", "start", "run", "status"])
+    parser.add_argument("--approval-url")
+    parser.add_argument("--position", action="append", type=_position, default=[])
+    parser.add_argument("--metric", choices=["D04", "E01", "D02"], default="D04")
+    args = parser.parse_args(argv)
+    if args.command == "register-approval" and args.approval_url is None:
+        parser.error("--approval-url is required for register-approval")
+    if args.command == "run" and not args.position:
+        parser.error("--position is required for run")
+    try:
+        if args.command == "register-approval":
+            from vnext.historical_source_acquisition import live_github_reader
+            result = calls.register_model_approval(repo_root=ROOT, comment_url=args.approval_url,
+                                                   reader=live_github_reader())
+        elif args.command == "start":
+            from vnext.historical_source_acquisition import live_github_reader
+            reader = live_github_reader()
+            allowance = calls.model_allowance(repo_root=ROOT, delegation_reader=reader)
+            result = calls.start_model_ledger(allowance=allowance, reader=reader)
+        elif args.command == "run":
+            result = run_positions(positions=args.position, metric_id=args.metric)
+        else:
+            result = status()
+    except (calls.HistoricalModelCallError, egress.HistoricalModelEgressError, ValueError) as error:
+        print(json.dumps({"status": "REFUSED", "reason": str(error)}, indent=1, sort_keys=True))
+        return 2
+    print(json.dumps(result, indent=1, sort_keys=True, default=str))
+    return 3 if result.get("stop") else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

@@ -0,0 +1,443 @@
+"""Issue #47's model egress: the one transport and the one execution entry.
+
+This file is new code inside the registration patch for independent security
+review (docs/evidence/issue47_history/model-egress/egress-registration.patch).
+It is not in the repository until that review accepts it. Everything a call is
+bound to - allowance, request, plan, ledger - is in ``historical_model_calls``,
+which is; this module adds only what opens the socket, or on the recorded path
+stands in for it:
+
+* ``_Transport.send``, the egress gate's one new transport caller. It refuses
+  unless WB-3 has already reserved this exact plan for this process and owner
+  and written its single egress marker. On the live path it re-verifies the
+  allowance against GitHub and rebuilds the request from the saved filing
+  immediately before the socket opens.
+* ``execute_historical_semantic``: one counted call for one prepared request.
+  No loop and no retry: a failure is a terminal, and a request is never
+  claimed twice.
+* ``register_from_slots``: a complete assessment is registered in the creator
+  journal only from this ledger's own successful slots, in the ledger's mode,
+  so a recorded ledger can never produce a LIVE registration.
+
+#28's call module is read for pure functions only (the provider body, the
+request digest, the usage observation); its ledger, delegation and batch
+authorizations are never consulted and cannot admit a #47 call.
+"""
+from datetime import datetime, timezone
+from pathlib import Path
+import os
+import uuid
+
+from .canonical import content_hash, sha256_bytes, sha256_file, strict_json_loads
+from .historical_model_calls import (_FACTORY as CALLS_FACTORY, PURPOSE, HistoricalModelLedger,
+                                     HistoricalSemanticRequest, _read, build_plan,
+                                     loaded_code_holds, model_allowance, request_in_scope,
+                                     sending, transport_policy, verify_model_wiring)
+from .normal_source_authority import ROOT
+
+
+class HistoricalModelEgressError(ValueError):
+    """A model call this Issue may not make; the reason names which check refused it."""
+
+
+class ApprovalNotConfirmed(ValueError):
+    """The approval could not be confirmed on GitHub right before the socket; nothing was sent."""
+
+
+class SourceAuthenticityFailure(ValueError):
+    """The request no longer rebuilds from the saved filing at the socket."""
+
+
+def _need(condition, reason):
+    if not condition:
+        raise HistoricalModelEgressError(reason)
+
+
+def _now():
+    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def _reservation_is_this_send_s(*, reservation, markers, plan, execution_id, owner_token,
+                                transport_kind):
+    """WB-3 reserved this plan for this process, owner and execution, and marked it once.
+
+    Each part on its own: a re-review removed every part but the marker count
+    together and no case noticed, so each is now a condition a case breaks by
+    itself.
+    """
+    return (reservation["owner_process_id"] == os.getpid()
+            and reservation["owner_token_hash"] == content_hash(value=owner_token)
+            and reservation["execution_id"] == execution_id
+            and len(markers) == 1
+            and markers[0]["ai_invocation_plan_id"] == plan["ai_invocation_plan_id"]
+            and markers[0]["transport_kind"] == transport_kind)
+
+
+class _Transport:
+    """The one #47 caller the registration patch adds to the egress gate's exact set."""
+
+    def __init__(self, *, prepared, policy, ledger, path, intent, recorded_wire, owner_token):
+        self.prepared, self.policy, self.ledger = prepared, policy, ledger
+        self.path, self.intent, self.recorded_wire = path, intent, recorded_wire
+        self.owner_token = owner_token
+        self.wire = None
+
+    @property
+    def transport_kind(self):
+        return "REAL_MODEL_PROVIDER" if self.ledger.live else "MOCK"
+
+    def send(self, *, request_body, plan, execution_id, attempt_ordinal):
+        from . import ai_adapter as adapter
+        from . import invocation_control as control
+        from .continuous_semantic_calls import usage_error
+        from .historical_source_acquisition import live_github_reader
+        from .sources import resolve_repository_file
+        # The slot this send is counted in: claimed, logged, open and this
+        # ledger's. An independent review reached the opener with a transport
+        # constructed directly and no slot at all.
+        _need(self.ledger.claimed_slot(path=self.path, intent=self.intent),
+              "ISSUE_47_MODEL_SEND_WITHOUT_A_COUNTED_SLOT")
+        _need(attempt_ordinal == 1 and request_body == self.prepared.provider_request_body_bytes
+              and plan["ai_invocation_plan_id"] == self.intent["plan_id"],
+              "ISSUE_47_MODEL_EXECUTION_REQUEST_CHANGED")
+        _need(control._SUCCESSOR_AUTHORITY.get() is self.prepared.authority and self.ledger._locked,
+              "ISSUE_47_MODEL_WB3_OWNER_CONTEXT_REQUIRED")
+        root = self.path / "invocation_control"
+        reservation = control._validate_active_reservation_for_plan(
+            reservation=strict_json_loads(text=resolve_repository_file(
+                repo_root=root, repo_relative_path="reservations/"
+                + plan["provider_request_identity"].split(":")[1] + ".json").read_text()),
+            plan=plan)
+        markers = control._egress_markers_for_execution(root=root, execution_id=execution_id)
+        _need(_reservation_is_this_send_s(reservation=reservation, markers=markers, plan=plan,
+                                          execution_id=execution_id, owner_token=self.owner_token,
+                                          transport_kind=self.transport_kind),
+              "ISSUE_47_MODEL_WB3_RESERVATION_OWNER_REQUIRED")
+
+        def source_check():
+            try:
+                self.prepared.validate(self.policy)
+            except ValueError as error:
+                raise SourceAuthenticityFailure(str(error)) from error
+
+        def approval_check():
+            # Changed, gone or unreadable, the approval is not confirmed, and
+            # the call stops with a terminal that says so - no socket opened.
+            # An independent review found a failed read here left the slot
+            # without one, so the channel stopped as an unknown outcome.
+            try:
+                model_allowance(repo_root=ROOT, delegation_reader=live_github_reader())
+            except (ValueError, OSError) as error:
+                raise ApprovalNotConfirmed(str(error)) from error
+
+        raw = output = None
+        request_id = error_class = error_detail = ""
+        status_code = 200
+        try:
+            if self.ledger.live:
+                _need(self.recorded_wire is None, "ISSUE_47_MODEL_RECORDED_BYTES_CANNOT_RUN_LIVE")
+                source_check()
+                approval_check()
+                with sending(prepared=self.prepared, ledger=self.ledger, path=self.path,
+                             intent=self.intent, execution_id=execution_id):
+                    result = adapter._build_repository_transport(policy=self.policy).complete(
+                        prepared_request=self.prepared,
+                        egress_capability=adapter._RESERVATION_OWNER_EGRESS_CAPABILITY,
+                        before_socket_open=source_check)
+                raw, output = result.raw_response_bytes, result.response_bytes
+                request_id = result.provider_request_id
+                # After the charge, so a disagreement is recorded with the
+                # response rather than raised past it: an independent review
+                # read that raising here dropped the raw response of a call
+                # already paid for. The disagreement stops the channel.
+                mismatch = adapter.transport_observation_mismatch(
+                    policy=self.policy, observation=result.observation, request_bytes=request_body)
+                if mismatch is not None:
+                    error_class = "TRANSPORT_OBSERVATION_CHANGED"
+                    error_detail = str(mismatch)[:400]
+            else:
+                _need(type(self.recorded_wire) is bytes, "ISSUE_47_MODEL_RECORDED_WIRE_REQUIRED")
+                raw = self.recorded_wire
+                request_id, model, text = adapter._deepseek_chat_output_text(raw_response_bytes=raw)
+                _need(model == self.policy.model, "ISSUE_47_MODEL_RECORDED_MODEL_CHANGED")
+                output = text.encode("utf-8")
+        except adapter.TransportAttemptError as error:
+            raw, output = error.raw_response_bytes, error.assistant_output_bytes
+            request_id, error_class = error.provider_request_id, error.error_class
+            status_code = adapter._controller_status_code(error_class=error_class)
+            error_detail = str(error)
+        except SourceAuthenticityFailure as error:
+            error_class, status_code, error_detail = "SOURCE_AUTHENTICITY_FAILED", 0, str(error)
+        except ApprovalNotConfirmed as error:
+            error_class, status_code, error_detail = ("APPROVAL_NOT_CONFIRMED_ON_GITHUB", 0,
+                                                      str(error)[:400])
+        except RecursionError as error:
+            # A response nested past the parser's depth. An independent review
+            # sent one and the error left the call path with the slot open, so
+            # the channel stopped as UNKNOWN; it is a response that was received
+            # and could not be read, recorded here with unknown usage - which
+            # stops the channel by the ledger's own rule, with a terminal.
+            error_class, error_detail = "RESPONSE_UNPARSEABLE", "RecursionError: " + str(error)[:200]
+        usage = _usage(raw)
+        if not error_class and self.ledger.live:
+            # The plan counted the exact outgoing body with the pinned
+            # reference tokenizer before the socket (execute refuses any other
+            # estimator on the live path). The service's count is compared with
+            # it before anything else: usage_error answers CONTEXT_LIMIT first,
+            # so a large disagreement read as a plain limit failure, which an
+            # independent review found did not stop the channel.
+            from .continuous_request_context import OUTPUT_RESERVE
+            reference_input = plan["observability"]["estimated_context_tokens"] - OUTPUT_RESERVE
+            if usage["input_tokens"] is not None and usage["input_tokens"] != reference_input:
+                error_class = "CONTEXT_REFERENCE_MISMATCH"
+        if not error_class:
+            # Recorded usage is synthetic and is not evidence about the
+            # reference tokenizer, so only the live path compares it.
+            error_class = ("USAGE_UNKNOWN" if usage["input_tokens"] is None
+                           or usage["output_tokens"] is None
+                           else usage_error(raw, enforce_total_context=self.ledger.live))
+        for name, data in (("raw-response.bin", raw), ("assistant-output.bin", output)):
+            if data is not None:
+                control._exclusive_write_bytes(path=self.path / "wire" / name, content=data)
+        body = {"record_type": "ISSUE_47_HISTORICAL_MODEL_WIRE", "execution_id": execution_id,
+                "intent_id": self.intent["intent_id"],
+                "ai_invocation_plan_id": plan["ai_invocation_plan_id"],
+                "request_sha256": sha256_bytes(content=request_body),
+                "provider_request_id": request_id, "status_code": status_code,
+                "error_class": error_class, "error_detail": error_detail, "usage": usage,
+                "observed_at_utc": _now(),
+                "raw_response_sha256": None if raw is None else sha256_bytes(content=raw),
+                "assistant_output_sha256": None if output is None else sha256_bytes(content=output),
+                "mode": self.ledger.mode}
+        self.wire = {**body, "wire_id": content_hash(value=body)}
+        control._exclusive_write_json(path=self.path / "wire" / "journal.json", value=self.wire)
+        if error_class in {"UNKNOWN_REMOTE_OUTCOME", "TIMEOUT"}:
+            raise control.UnknownRemoteOutcomeError(error_class)
+        return {"status_code": status_code, "error_class": error_class,
+                "response_body": output if output is not None else raw or b"",
+                "provider_request_id": request_id, "usage": usage}
+
+
+def _usage(raw):
+    """The service's usage, or unknown usage when its response is nested past the parser's depth."""
+    from .continuous_semantic_calls import usage_observation
+    try:
+        return usage_observation(raw)
+    except RecursionError:
+        return usage_observation(None)
+
+
+def execute_historical_semantic(*, prepared, ledger, recorded_wire=None, purpose=PURPOSE):
+    """One counted, WB-3-owned call for one prepared request; no loop, no retry.
+
+    Returns:
+        (slot path, summary). A failed call is a terminal like any other: it is
+        counted, and whether it stops the channel is the ledger's decision.
+    """
+    from . import invocation_control as control
+    from .historical_model_calls import REQUEST_TYPES, ledger_digest
+    _need(type(prepared) is HistoricalSemanticRequest and prepared._factory is CALLS_FACTORY,
+          "ISSUE_47_MODEL_PREPARED_REQUEST_REQUIRED")
+    _need(type(ledger) is HistoricalModelLedger and ledger._factory is CALLS_FACTORY,
+          "ISSUE_47_MODEL_LEDGER_REQUIRED")
+    _need(ledger.binding["delegation_url"] == prepared.allowance["delegation_url"]
+          and ledger.binding["delegation_body_sha256"]
+          == prepared.allowance["delegation_body_sha256"]
+          and ledger.binding["limits"]
+          == prepared.allowance["maximum_additional_provider_paid_sec_calls"],
+          "ISSUE_47_MODEL_LEDGER_IS_FOR_ANOTHER_ALLOWANCE")
+    request_fields = strict_json_loads(text=prepared.request_bytes.decode("utf-8"))
+    # Each metric's own contract: D04's native interpretation request or E01's
+    # content-confirmation request, and nothing else under either name.
+    _need(request_fields.get("record_type") == REQUEST_TYPES.get(prepared.metric_id),
+          "ISSUE_47_MODEL_REQUEST_TYPE_IS_NOT_THE_METRIC_S")
+    if ledger.live:
+        from .ai_adapter import api_key_environment_name
+        _need(recorded_wire is None, "ISSUE_47_MODEL_RECORDED_BYTES_CANNOT_RUN_LIVE")
+        _need(ledger.root == Path(prepared.allowance["budget_root"]),
+              "ISSUE_47_MODEL_LIVE_LEDGER_ROOT_CHANGED")
+        selected = transport_policy(allowance=prepared.allowance, repo_root=ROOT)
+        _need(bool(os.environ.get(api_key_environment_name(policy=selected), "").strip()),
+              "ISSUE_47_MODEL_API_KEY_REQUIRED")
+        verify_model_wiring(receipt_path=prepared.allowance["model_wiring_receipt_path"],
+                            receipt_id=prepared.allowance["model_wiring_receipt_id"])
+    else:
+        _need(type(recorded_wire) is bytes, "ISSUE_47_MODEL_RECORDED_WIRE_REQUIRED")
+    policy, plan, request = build_plan(prepared)
+    if ledger.live:
+        # Planning has imported what the call runs (the pinned tokenizer
+        # among it), so what this process loaded is checked here, before a
+        # claim, and again at the socket.
+        loaded_code_holds(prepared.authority)
+    digest = ledger_digest(request, policy)
+    # A grant covers a request only by naming its digest: the exact requests
+    # the owner approved, not any request built for an approved position.
+    grants = request_in_scope(allowance=prepared.allowance, metric_id=prepared.metric_id,
+                              company_id=prepared.company_id, report_end=prepared.report_end,
+                              purpose=purpose, request_digest=digest)
+    # The live path compares the service's count with the pinned reference
+    # tokenizer's; without it that comparison would be skipped, so a live call
+    # is not planned by any other estimator.
+    _need(not ledger.live or plan["observability"]["estimator_method"] == "PINNED_REFERENCE_CHAT_FORMAT",
+          "ISSUE_47_MODEL_REFERENCE_TOKENIZER_REQUIRED")
+    _, admission = prepared.validate(policy)
+    _need(not ledger.live or admission["source_credit"] != "RECORDED_TEST_ONLY",
+          "ISSUE_47_MODEL_RECORDED_SOURCE_CANNOT_RUN_LIVE")
+    check_response, accept = _contract(prepared=prepared, request=request_fields, plan=plan)
+
+    # An answer nested past the parser's depth is an answer outside the
+    # contract, like any other: a failed call with a terminal, not an error
+    # that leaves the slot open.
+    def response_validator(**kwargs):
+        try:
+            check_response(kwargs["response_body"])
+        except (ValueError, KeyError, TypeError, RecursionError) as error:
+            raise control.SchemaViolationError(str(error)[:400]) from error
+
+    def evidence_validator(**kwargs):
+        try:
+            return accept(kwargs["response_body"])
+        except (ValueError, KeyError, TypeError, RecursionError) as error:
+            raise control.EvidenceFailureError(str(error)[:400]) from error
+
+    with ledger.locked():
+        path, intent = ledger.claim(
+            request_digest=digest, plan_id=plan["ai_invocation_plan_id"], purpose=purpose,
+            grants=grants, request_identity=plan["provider_request_identity"],
+            authority_files_hash="sha256:" + sha256_bytes(content=prepared.authority._files))
+        control._exclusive_write_bytes(path=path / "source.json", content=prepared.source_bytes)
+        control._exclusive_write_bytes(path=path / "semantic-request.json",
+                                       content=prepared.request_bytes)
+        owner, when = str(uuid.uuid4()), _now()
+        transport = _Transport(prepared=prepared, policy=policy, ledger=ledger, path=path,
+                               intent=intent, recorded_wire=recorded_wire, owner_token=owner)
+        execution = control.execute_successor_invocation(
+            repo_root=ROOT, authority=prepared.authority, workspace_dir=path, plan=plan,
+            request_body=prepared.provider_request_body_bytes,
+            execution_id=control.execution_identity(
+                ai_invocation_plan_id=plan["ai_invocation_plan_id"], owner_token=owner,
+                authorized_at_utc=when),
+            owner_token=owner, authorized_at_utc=when, clock=_now, transport=transport,
+            response_validator=response_validator, evidence_validator=evidence_validator)
+        terminal = ledger.finish(path=path, intent=intent, execution=execution,
+                                 wire=transport.wire)
+    return path, {"execution_receipt_id": execution["execution_receipt_id"],
+                  "status": execution["status"], "stop_reason": terminal["stop_reason"],
+                  "grants": grants, "mode": ledger.mode, "native_result_created": False,
+                  "production_authorized": False}
+
+
+def _contract(*, prepared, request, plan):
+    """The response check and the acceptance of the metric's own contract."""
+    if prepared.metric_id == "D04":
+        from .d04_native_assessment import build_acceptance, validate_response
+        return (lambda body: validate_response(request=request, raw_response=body),
+                lambda body: build_acceptance(prepared=prepared, plan=plan, response_body=body))
+    if prepared.metric_id == "D02":
+        from .historical_legal_review import build_acceptance as build_review_acceptance
+        from .historical_legal_review import validate_answer as validate_review
+        from .historical_results import TEXT_SPEC_PATHS
+        from .historical_spec_revision import compile_historical_spec_file
+        spec = compile_historical_spec_file(repo_root=ROOT, repo_relative_path=TEXT_SPEC_PATHS["D02"],
+                                            dependency_specs={})
+        references = [request["filing"]["source_reference_id"]]
+        return (lambda body: validate_review(request=request, raw_output=body),
+                lambda body: build_review_acceptance(request=request, source_reference_ids=references,
+                                                     plan=plan, response_body=body,
+                                                     spec_semantic_hash=spec["spec_semantic_hash"]))
+    from .historical_ma_confirmation import build_acceptance, validate_answer
+    from .historical_results import _successor_event_spec
+    _path, spec = _successor_event_spec(repo_root=ROOT, metric_id="E01")
+    references = list(dict.fromkeys(item["primary_source_reference_id"] for item in request["items"]))
+    return (lambda body: validate_answer(request=request, raw_output=body),
+            lambda body: build_acceptance(request=request, source_reference_ids=references, plan=plan,
+                                          response_body=body,
+                                          spec_semantic_hash=spec["spec_semantic_hash"]))
+
+
+def register_from_slots(*, prepared_requests, ledger, slots):
+    """Register a complete assessment from this ledger's own successful slots.
+
+    Each request of the pinned source must be answered by exactly one slot of
+    this ledger whose terminal succeeded without a stop, whose claimed request
+    digest is that request's, and whose sealed evidence still hashes the output
+    it registers. The registration takes the ledger's mode, never a caller's.
+    """
+    from sec_http import write_immutable_bytes
+    from .historical_counted_calls import counted_calls
+    from .historical_model_calls import ledger_digest
+    from .historical_semantic_results import (journal_directory, pinned_native_source,
+                                              registered_export_bytes, registered_record)
+    _need(type(ledger) is HistoricalModelLedger and ledger._factory is CALLS_FACTORY,
+          "ISSUE_47_MODEL_LEDGER_REQUIRED")
+    _need(bool(prepared_requests) and len(prepared_requests) == len(slots)
+          and all(type(p) is HistoricalSemanticRequest for p in prepared_requests)
+          and len({p.source_bytes for p in prepared_requests}) == 1,
+          "ISSUE_47_MODEL_REGISTRATION_REQUESTS_MALFORMED")
+    first = prepared_requests[0]
+    policy = transport_policy(allowance=first.allowance, repo_root=ROOT)
+    first.validate(policy)
+    source = (pinned_native_source(repo_root=first.data_root, company_id=first.company_id,
+                                   metric_id=first.metric_id,
+                                   period_selection=first.period_selection)
+              if first.metric_id == "D04" else None)
+    ledger.granted()
+    # Read under the lock, which is what checks the binding, its anchor and
+    # the claim log's copy; a caller already holding it is not locked twice.
+    if ledger._locked:
+        ledger.snapshot()
+    else:
+        with ledger.locked():
+            ledger.snapshot()
+    outputs, calls = {}, []
+    for prepared, slot in zip(prepared_requests, slots):
+        slot = Path(slot)
+        _need(slot.parent == ledger.root / "calls", "ISSUE_47_MODEL_SLOT_IS_NOT_THIS_LEDGER_S")
+        intent, terminal = _read(slot, "intent.json"), _read(slot, "terminal.json")
+        request, _ = prepared.validate(policy)
+        _need(intent["allowance_binding_id"] == ledger.binding["binding_id"]
+              and intent["request_digest"] == ledger_digest(request, policy),
+              "ISSUE_47_MODEL_SLOT_IS_FOR_ANOTHER_REQUEST")
+        _need(terminal["intent_id"] == intent["intent_id"] and terminal["status"] == "SUCCEEDED"
+              and terminal["stop_reason"] == "", "ISSUE_47_MODEL_SLOT_DID_NOT_SUCCEED")
+        output_path = slot / "wire" / "assistant-output.bin"
+        wire = _read(slot, "wire/journal.json")
+        output = output_path.read_bytes()
+        _need(wire["assistant_output_sha256"] == sha256_bytes(content=output)
+              and terminal["evidence"].get("wire/assistant-output.bin")
+              == sha256_file(path=output_path) and wire["mode"] == ledger.mode,
+              "ISSUE_47_MODEL_SLOT_OUTPUT_CHANGED")
+        _need(request["request_id"] not in outputs, "ISSUE_47_MODEL_REQUEST_ANSWERED_TWICE")
+        outputs[request["request_id"]] = output
+        calls.append({"request_id": request["request_id"], "intent": intent, "terminal": terminal,
+                      "wire": wire})
+    # The calls travel with the registration, so a consumer can check them
+    # without this ledger: a LIVE registration is accepted only with the
+    # counted calls that answered it, from the ledger the registered approval
+    # granted (historical_counted_calls).
+    counted = counted_calls(ledger_binding=ledger.binding, transport=first.allowance["transport"],
+                            mode=ledger.mode, calls=calls)
+    if first.metric_id == "D02":
+        # One request per filing; its checked answer is the registration.
+        from .historical_legal_review import register_review
+        (request_id, output), = outputs.items()
+        request = strict_json_loads(text=first.request_bytes.decode("utf-8"))
+        return register_review(request=request, company_id=first.company_id,
+                               period_selection_id=first.period_selection["selection_id"],
+                               output=output, mode=ledger.mode, counted=counted)
+    if first.metric_id == "E01":
+        # One request per window; its checked answer is the registration.
+        from .historical_ma_confirmation import register_confirmation
+        (request_id, output), = outputs.items()

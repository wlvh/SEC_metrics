+
+def _grant(first=PERIOD, last=PERIOD, *, metric="D04", company=COMPANY, digests=None):
+    return {"purposes": [calls.PURPOSE], "metric_ids": [metric], "company_ids": [company],
+            "earliest_report_end": first, "latest_report_end": last,
+            "grants": [{"grant": "TEST_" + metric + "_" + company, "metric_ids": [metric],
+                        "company_ids": [company], "earliest_report_end": first,
+                        "latest_report_end": last,
+                        "request_digests": list(digests or ["sha256:" + "0" * 64])}]}
+
+
+def install_allowance(budget_root, *, receipt_id, limits=(12, 12, 0), scope=None):
+    """Write the fixture allowance and its approval; returns the comment the reader serves."""
+    policy = {"requirement_id": calls.REQUIREMENT_ID, "repository": "wlvh/SEC_metrics",
+              "approver_login": "wlvh", "delegation_url": URL,
+              "delegation_record_path": RECORD_PATH, "budget_root": str(budget_root),
+              "maximum_additional_provider_paid_sec_calls": list(limits),
+              "scope": scope or _grant(), "transport": dict(TRANSPORT),
+              "retry_policy": dict(calls.FIXED_RETRY_POLICY),
+              "model_wiring_receipt_path": RECEIPT_PATH, "model_wiring_receipt_id": receipt_id}
+    body = {"record_type": calls.DELEGATION_TYPE, "requirement_id": calls.REQUIREMENT_ID,
+            "fixture": "RECORDED_TEST_ONLY_NOT_AN_APPROVAL", "production_authorized": False,
+            **{field: policy[field] for field in calls.RESTATED_BY_THE_COMMENT}}
+    text = json.dumps(body, sort_keys=True)
+    comment = {"id": 1000000001, "html_url": URL,
+               "issue_url": "https://api.github.com/repos/wlvh/SEC_metrics/issues/47",
+               "user": {"login": "wlvh", "id": 30534800, "type": "User"},
+               "author_association": "OWNER", "performed_via_github_app": None, "body": text,
+               "created_at": "2026-09-27T00:00:00Z", "updated_at": "2026-09-27T00:00:00Z"}
+    policy["delegation_body_sha256"] = sha256_bytes(content=text.encode("utf-8"))
+    # A real allowance in this tree is never overwritten: the suite refuses to
+    # run beside one, and writes its fixtures exclusively. An independent
+    # review found the previous fixtures overwrote and then deleted the
+    # allowance file of whatever tree the suite ran in.
+    if not _WRITTEN:
+        if (ROOT / calls.ALLOWANCE_PATH).exists() or (ROOT / FIXTURE_DIR).exists():
+            raise unittest.SkipTest("REFUSED: an allowance or fixture directory already exists in this tree")
+    (ROOT / FIXTURE_DIR).mkdir(parents=True, exist_ok=True)
+    for relative, value in ((RECORD_PATH, comment), (calls.ALLOWANCE_PATH, policy)):
+        data = json.dumps(value).encode("utf-8")
+        path = ROOT / relative
+        if relative in _WRITTEN:
+            _need_ours(path, relative)
+            path.unlink()
+        with path.open("xb") as handle:
+            handle.write(data)
+        _WRITTEN[relative] = sha256_bytes(content=data)
+    return comment
+
+
+_WRITTEN = {}
+
+
+def reset_ledger(root):
+    """Start a test ledger afresh: its root, and the anchor, claim-log copy and start beside it."""
+    from vnext.historical_ledger_start import start_record_path
+    shutil.rmtree(root, ignore_errors=True)
+    calls.HistoricalModelLedger.anchor_path(root).unlink(missing_ok=True)
+    calls.HistoricalModelLedger.mirror_path(root).unlink(missing_ok=True)
+    start_record_path(root).unlink(missing_ok=True)
+
+
+def _need_ours(path, relative):
+    if not path.is_file() or sha256_bytes(content=path.read_bytes()) != _WRITTEN[relative]:
+        raise AssertionError("FIXTURE_REPLACED_BY_SOMETHING_ELSE:" + relative)
+
+
+def remove_allowance():
+    """Remove only the fixtures this suite wrote, and only if they are still its bytes."""
+    for relative in list(_WRITTEN):
+        path = ROOT / relative
+        if path.exists():
+            _need_ours(path, relative)
+            path.unlink()
+        del _WRITTEN[relative]
+    receipt = ROOT / RECEIPT_PATH
+    if receipt.exists():
+        receipt.unlink()
+    if (ROOT / FIXTURE_DIR).is_dir() and not any((ROOT / FIXTURE_DIR).iterdir()):
+        (ROOT / FIXTURE_DIR).rmdir()
+
+
+def _terminated(signum, frame):
+    """A terminated suite unwinds like an interrupted one, so its cleanups run.
+
+    An independent review ended the suite with SIGTERM right after the runner
+    case wrote a LIVE registration; the record and the fixture allowance stayed
+    in the tree. A Run no longer reads such a record - no approval was
+    registered for a fixture's ledger (historical_counted_calls) - but the
+    tree should not keep it: every case's cleanup puts the creator journal
+    back (``_Isolated.setUp``), and the exit hooks below put back the journal
+    of a case a signal ended and remove the fixtures, once the signal unwinds
+    the stack. Only SIGKILL still leaves them, and then the next run refuses
+    to start.
+    """
+    raise KeyboardInterrupt("terminated by signal " + str(signum))
+
+
+# The creator journal every registration path writes - D04's, E01's and D02's
+# alike (historical_semantic_results.JOURNAL). It lives in ``.git``, outside
+# the fixtures' removal and outside every tree check of the verification. A
+# pre-flight injection that dropped E01's "LIVE needs counted calls" check let
+# a case register LIVE and fail on that very line, before any cleanup; the
+# record stayed, and an hour later the sealed verification's own suite failed
+# on it in a case that reads that window. Cases clean what they write when
+# they pass; under an injection they fail first, so the fixture does it.
+JOURNAL_ROOT = ROOT / semantic.JOURNAL
+_OPEN_CASE = {}
+
+
+def journal_state():
+    """The creator journal as it stands: whether it exists, and every file's bytes."""
+    if not JOURNAL_ROOT.is_dir():
+        return {"exists": False, "files": {}, "directories": set()}
+    files, directories = {}, set()
+    for path in JOURNAL_ROOT.rglob("*"):
+        relative = path.relative_to(JOURNAL_ROOT).as_posix()
+        if path.is_dir() and not path.is_symlink():
+            directories.add(relative)
+        else:
+            files[relative] = path.read_bytes()
+    return {"exists": True, "files": files, "directories": directories}
+
+
+def restore_journal(before):
+    """Put the journal back as ``before`` found it; returns the files a case changed.
+
+    A file the case added is removed, whatever it is: a registration written
+    under an injection is exactly what must not stay. A file that was there
+    before and now differs or is gone is written back, and named, because no
+    case writes over a registration it did not make.
+    """
+    now = journal_state()
+    for relative in sorted(set(now["files"]) - set(before["files"])):
+        (JOURNAL_ROOT / relative).unlink()
+    changed = sorted(relative for relative, raw in before["files"].items()
+                     if now["files"].get(relative) != raw)
+    for relative in changed:
+        target = JOURNAL_ROOT / relative
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(before["files"][relative])
+    for relative in sorted(now["directories"] - before["directories"],
+                           key=lambda value: value.count("/"), reverse=True):
+        directory = JOURNAL_ROOT / relative
+        if directory.is_dir() and not any(directory.iterdir()):
+            directory.rmdir()
+    if not before["exists"] and JOURNAL_ROOT.is_dir() and not any(JOURNAL_ROOT.iterdir()):
+        JOURNAL_ROOT.rmdir()
+    return changed
+
+
+def live_registrations_for(*, metric_id, company_id, period_selection_id):
+    """LIVE records in this tree's journal for one position, and any LIVE file that does not read."""
+    found = []
+    for record_path in sorted((JOURNAL_ROOT / "LIVE" / metric_id).rglob("*")):
+        if record_path.is_dir():
+            continue
+        try:
+            record = json.loads(record_path.read_text(encoding="utf-8"))
+        except (UnicodeDecodeError, ValueError):
+            found.append(record_path)
+            continue
+        if (record.get("company_id"), record.get("period_selection_id")) == (company_id,
+                                                                            period_selection_id):
+            found.append(record_path)
+    return found
+
+
+signal.signal(signal.SIGTERM, _terminated)
+atexit.register(lambda: remove_allowance() if _WRITTEN else None)
+atexit.register(lambda: restore_journal(_OPEN_CASE["journal"]) if "journal" in _OPEN_CASE else None)
+
+
+def fixture_receipt():
+    """A receipt over the current call path, for the live-path mechanics only.
+
+    The real receipt is sealed by the verification harness after this whole
+    suite has passed; this one lets the live-path tests exercise the check
+    that reads it.
+    """
+    bound = {}
+    for relative in calls.CALL_PATH_FILES:
+        raw = (ROOT / relative).read_bytes()
+        bound[relative] = {"sha256": sha256_bytes(content=raw), "size": len(raw)}
+    body = {"record_type": "ISSUE_47_MODEL_EGRESS_OFFLINE_VERIFICATION",
+            "requirement_id": calls.REQUIREMENT_ID, "all_checks_passed": True,
+            "calls": {"provider": 0, "paid": 0, "sec": 0}, "bound_files": bound,
+            "fixture": "RECORDED_TEST_ONLY"}
+    return {**body, "receipt_id": content_hash(value=body)}
+
+
+def seal_fixture_receipt(receipt):
+    (ROOT / RECEIPT_PATH).write_text(json.dumps(receipt), encoding="utf-8")
+
+
+def wire(output, *, usage=True, prompt_tokens=100, completion_tokens=20, model="deepseek-flash"):
+    value = {"id": "issue47-offline", "model": model,
+             "choices": [{"message": {"role": "assistant", "content": output.decode("utf-8")},
+                          "finish_reason": "stop"}]}
+    if usage:
+        value["usage"] = {"prompt_tokens": prompt_tokens, "completion_tokens": completion_tokens,
+                          "total_tokens": prompt_tokens + completion_tokens, "prompt_cache_hit_tokens": 0,
+                          "prompt_cache_miss_tokens": prompt_tokens}
+    return canonical_json_bytes(value=value)
+
+
+def reference_prompt_tokens(prepared):
+    """What the pinned reference tokenizer counts for this body - what a real service reports."""
+    from vnext.continuous_request_context import measure_request
+    return measure_request(prepared.provider_request_body_bytes)["input_tokens"]
+
+
+class _Response(io.BytesIO):
+    headers = {"x-request-id": "issue47-offline"}
+
+
+def e01_output(request, decide=lambda item: "DOES_NOT_REPORT_A_TRANSACTION"):
+    """A synthetic E01 answer: a decision per item, quoting the item's own opening words."""
+    return json.dumps({"item_decisions": [
+        {"item_id": item["item_id"], "decision": decide(item), "quote": item["text"][:120].strip()}
+        for item in request["items"]]}).encode("utf-8")
+
+
+def d02_output(request):
+    """A synthetic D02 answer: every must-decide block out, nothing added."""
+    return json.dumps({"decisions": [{"block_id": identity, "decision": "OUT_OF_SCOPE", "quote": None}
+                                     for identity in request["must_decide"]],
+                       "also_in_scope": []}).encode("utf-8")
+
+
+class _Isolated(unittest.TestCase):
+    """No DNS, no raw socket, no SEC, for every case."""
+
+    LIMITS = (12, 12, 0)
+    # The metric, company and period a class's allowance grants and its requests are built for.
+    CASE = ("D04", COMPANY, PERIOD)
+    # How many of the position's requests the grant names, smallest first; None names all.
+    GRANTED_REQUESTS = None
+
+    @classmethod
+    def setUpClass(cls):
+        metric, company, period = cls.CASE
+        # The cases read this position's LIVE registrations and expect none: a
+        # test's RECORDED one must not be read by a batch, and the runner
+        # registers LIVE here and removes it. A tree whose journal already
+        # holds a LIVE registration for it is not one they can run in, and
+        # says so here rather than failing whichever case reads it first.
+        existing = live_registrations_for(
+            metric_id=metric, company_id=company,
+            period_selection_id=resolve_period_selection(repo_root=ROOT, company_id=company,
+                                                         report_end=period)["selection_id"])
+        if existing:
+            raise unittest.SkipTest("REFUSED: the creator journal already holds a LIVE registration for "
+                                    + metric + " " + company + " " + period + ": "
+                                    + ", ".join(str(p.relative_to(ROOT)) for p in existing))
+        cls._guards = [patch.object(socket, "getaddrinfo", side_effect=AssertionError("DNS_FORBIDDEN")),
+                       patch.object(socket, "create_connection",
+                                    side_effect=AssertionError("SOCKET_FORBIDDEN")),
+                       patch("sec_http.urlopen", side_effect=AssertionError("SEC_FORBIDDEN"))]
+        for guard in cls._guards:
+            guard.start()
+        cls.temporary = Path(tempfile.mkdtemp(prefix="issue47-egress-"))
+        # The receipt is computed first because the approval names it, and
+        # written after, because the fixtures refuse to start in a tree that
+        # already holds a fixture directory.
+        receipt = fixture_receipt()
+        metric, company, period = cls.CASE
+        # The approval names the exact requests, so the fixture computes them
+        # the way a proposal does - before any allowance or authority exists.
+        planned = calls.planned_request_digests(
+            company_id=company, metric_id=metric, transport=TRANSPORT,
+            period_selection=resolve_period_selection(repo_root=ROOT, company_id=company,
+                                                      report_end=period))
+        cls.planned = planned
+        granted = planned if cls.GRANTED_REQUESTS is None else planned[:cls.GRANTED_REQUESTS]
+        cls.comment = install_allowance(cls.temporary / "granted-ledger", limits=cls.LIMITS,
+                                        receipt_id=receipt["receipt_id"],
+                                        scope=_grant(period, period, metric=metric, company=company,
+                                                     digests=granted))
+        seal_fixture_receipt(receipt)
+        cls.selection = resolve_period_selection(repo_root=ROOT, company_id=company,
+                                                 report_end=period)
+        cls.allowance = calls.model_allowance(repo_root=ROOT)
+        cls.authority = control.prepare_successor_invocation_authority(
+            repo_root=ROOT, requirement_id=calls.REQUIREMENT_ID)
+        cls.requests = calls.prepare_historical_requests(
+            company_id=company, metric_id=metric, period_selection=cls.selection,
+            authority=cls.authority, allowance=cls.allowance, data_root=ROOT)
+
+    @classmethod
+    def tearDownClass(cls):
+        remove_allowance()
+        shutil.rmtree(cls.temporary, ignore_errors=True)
+        for guard in cls._guards:
+            guard.stop()
+
+    def setUp(self):
+        before = journal_state()
+        _OPEN_CASE["journal"] = before
+        self.addCleanup(self._leave_the_journal_as_found, before)
+
+    def _leave_the_journal_as_found(self, before):
+        changed = restore_journal(before)
+        _OPEN_CASE.pop("journal", None)
+        if changed:
+            raise AssertionError("A_CASE_CHANGED_A_REGISTRATION_IT_DID_NOT_WRITE:" + ",".join(changed))
+
+    def recorded(self, name):
+        return calls.recorded_model_ledger(root=self.temporary / name, allowance=self.allowance)
+
+    @staticmethod
+    def output(prepared):
+        request = strict_json_loads(text=prepared.request_bytes.decode("utf-8"))
+        if prepared.metric_id == "D02":
+            return d02_output(request)
+        return e01_output(request) if prepared.metric_id == "E01" else synthetic_output(request)
+
+    def smallest(self):
+        return min(self.requests, key=lambda r: len(r.provider_request_body_bytes))
+
+    def slots(self, ledger):
+        calls_dir = ledger.root / "calls"
+        return sorted(calls_dir.iterdir()) if calls_dir.is_dir() else []
+
+
+class OnlyIssue47sOwnAuthorityReachesTheCallPath(_Isolated):
+    """Wrong generations and lookalikes are refused before any slot is claimed."""
+
+    def test_the_controller_makes_the_authority_from_47s_allowance(self):
+        identity, policy, transport = self.authority._check()
+        self.assertEqual(calls.REQUIREMENT_ID, identity["requirement_id"])
+        self.assertEqual(0, policy["automatic_retry_count"])
+        self.assertFalse(policy["response_reuse_authorized"])
+        self.assertEqual(200000, transport["pre_execution_context_tokens_max"])
+        files = strict_json_loads(text=self.authority._files.decode("utf-8"))
+        for relative in (*calls.CALL_PATH_FILES, calls.ALLOWANCE_PATH, RECORD_PATH,
+                         "scripts/vnext/invocation_control.py", "scripts/vnext/ai_adapter.py"):
+            self.assertIn(relative, files)
+
+    def test_without_the_allowance_there_is_no_authority(self):
+        saved = (ROOT / calls.ALLOWANCE_PATH).read_bytes()
+        (ROOT / calls.ALLOWANCE_PATH).unlink()
+        try:
+            with self.assertRaisesRegex(calls.HistoricalModelCallError,
+                                        "ISSUE_47_MODEL_ALLOWANCE_NOT_GRANTED"):
+                control.prepare_successor_invocation_authority(

+    def test_a_source_edited_and_resealed_does_not_rebuild_from_the_filing(self):
+        """Every id recomputed over an edited unit still is not the filing's text.
+
+        An independent review edited one unit's text, recomputed its hash, size
+        and id, the source id, and the request and provider body built from it,
+        and the request reached the opener: a content-addressed source proves
+        only that it is itself. The forgery here is made the same way, so it
+        passes every check but the one that rebuilds the source from the filing.
+        """
+        from vnext.continuous_semantic_calls import request_body
+        from vnext.historical_semantic_results import pinned_requests
+        from vnext.native_unit_index import evidence_json_bytes
+        from vnext.r6_semantic_source import _bytes
+        policy = calls.transport_policy(allowance=self.allowance)
+        unit = None
+        for prepared in sorted(self.requests, key=lambda r: len(r.provider_request_body_bytes)):
+            source = strict_json_loads(text=prepared.source_bytes.decode("utf-8"))
+            request = strict_json_loads(text=prepared.request_bytes.decode("utf-8"))
+            # A request carries its units compacted against shared
+            # dictionaries, so a source unit is found by its id, not its bytes.
+            sent = {unit["unit_id"] for unit in request["units"]}
+            unit = next((unit for unit in source["units"]
+                         if unit["unit_id"] in sent and unit["kind"] == "VISIBLE_TEXT"
+                         and " the " in _bytes(unit["payload"]).decode()), None)
+            if unit is not None:
+                break
+        self.assertIsNotNone(unit, "no request of this source sends a prose unit to edit")
+        position = pinned_requests(source).index(request)
+        unit["payload"] = strict_json_loads(text=_bytes(unit["payload"]).decode().replace(" the ", " THE ", 1))
+        raw = _bytes(unit["payload"])
+        unit["payload_sha256"], unit["payload_bytes"] = sha256_bytes(content=raw), len(raw)
+        old_id = unit["unit_id"]
+        unit["unit_id"] = content_hash(value={k: v for k, v in unit.items() if k != "unit_id"})
+        source["required_unit_ids"] = [unit["unit_id"] if uid == old_id else uid
+                                       for uid in source["required_unit_ids"]]
+        source["semantic_source_id"] = content_hash(
+            value={k: v for k, v in source.items() if k != "semantic_source_id"})
+        forged_request = pinned_requests(source)[position]
+        forged = dataclasses.replace(
+            prepared, source_bytes=evidence_json_bytes(source),
+            request_bytes=evidence_json_bytes(forged_request),
+            provider_request_body_bytes=request_body(forged_request, policy),
+            output_schema_bytes=canonical_json_bytes(value=forged_request["response_protocol"]))
+        self.assertNotEqual(prepared.provider_request_body_bytes, forged.provider_request_body_bytes)
+        with self.assertRaisesRegex(calls.HistoricalModelCallError,
+                                    "ISSUE_47_MODEL_SOURCE_DOES_NOT_REBUILD_FROM_THE_FILING"):
+            forged.validate(policy)

@@ -0,0 +1,616 @@
+"""Issue #47's model egress, verified offline in a tree where the registration patch is applied.
+
+This suite is part of the patch for independent security review
+(docs/evidence/issue47_history/model-egress/). It runs only where
+``historical_model_egress`` exists and the three boundary files carry the
+patch; it opens no socket. DNS, raw sockets and SEC are refused for the whole
+run, and the one provider opener is replaced by a controlled one that asserts
+the exact URL, body and timeout before returning recorded bytes.
+
+The allowance and approval it uses are fixtures written into the tree for the
+run and removed after it. The approval's body says, in a field of its own,
+that it is a recorded test fixture and not an approval; the live path reads it
+only through a reader the test supplies. Outputs are the semantic route
+suite's synthetic fixtures - the frozen checker's own relations - so a
+registration made here proves the path from a counted call to the creator
+journal, never a filing's content.
+"""
+import dataclasses
+import io
+import json
+import os
+import shutil
+import socket
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from urllib.error import HTTPError
+
+from tests.vnext.common import REPO_ROOT as ROOT
+from tests.vnext.test_historical_semantic_routes import synthetic_output
+from vnext import ai_adapter as adapter
+from vnext import historical_model_calls as calls
+from vnext import historical_model_egress as egress
+from vnext import historical_semantic_results as semantic
+from vnext import invocation_control as control
+from vnext.canonical import canonical_json_bytes, content_hash, sha256_bytes, strict_json_loads
+from vnext.normal_period_selection import resolve_period_selection
+
+COMPANY, PERIOD, OTHER_PERIOD = "marriott_international", "2023-12-31", "2024-12-31"
+FIXTURE_DIR = "docs/evidence/issue47_history/model-egress/test-fixture"
+RECORD_PATH = FIXTURE_DIR + "/delegation.json"
+RECEIPT_PATH = FIXTURE_DIR + "/wiring-receipt.json"
+URL = "https://github.com/wlvh/SEC_metrics/issues/47#issuecomment-1000000001"
+TRANSPORT = {"provider": "deepseek", "model": "deepseek-flash", "api": "chat_completions",
+             "endpoint_host": adapter._DEEPSEEK_ENDPOINT_HOST,
+             "region": "provider-managed-no-residency-guarantee",
+             "retention": "provider-managed; no zero-retention claim",
+             "data_use": "provider-managed; no training or data-use guarantee",
+             "timeout_seconds": 120, "retry_count": 0, "maximum_payload_bytes": 8388608,
+             "filing_egress_policy": "PUBLIC_SEC_FILING_CONTENT_ONLY"}
+
+
+def _grant(first=PERIOD, last=PERIOD):
+    return {"purposes": [calls.PURPOSE], "metric_ids": ["D04"], "company_ids": [COMPANY],
+            "earliest_report_end": first, "latest_report_end": last,
+            "grants": [{"grant": "TEST_D04_" + COMPANY, "metric_ids": ["D04"],
+                        "company_ids": [COMPANY], "earliest_report_end": first,
+                        "latest_report_end": last}]}
+
+
+def install_allowance(budget_root, *, limits=(12, 12, 0), scope=None):
+    """Write the fixture allowance and its approval; returns the comment the reader serves."""
+    policy = {"requirement_id": calls.REQUIREMENT_ID, "repository": "wlvh/SEC_metrics",
+              "approver_login": "wlvh", "delegation_url": URL,
+              "delegation_record_path": RECORD_PATH, "budget_root": str(budget_root),
+              "maximum_additional_provider_paid_sec_calls": list(limits),
+              "scope": scope or _grant(), "transport": dict(TRANSPORT),
+              "retry_policy": dict(calls.FIXED_RETRY_POLICY),
+              "model_wiring_receipt_path": RECEIPT_PATH}
+    body = {"record_type": calls.DELEGATION_TYPE, "requirement_id": calls.REQUIREMENT_ID,
+            "fixture": "RECORDED_TEST_ONLY_NOT_AN_APPROVAL", "production_authorized": False,
+            **{field: policy[field] for field in calls.RESTATED_BY_THE_COMMENT}}
+    text = json.dumps(body, sort_keys=True)
+    comment = {"id": 1000000001, "html_url": URL,
+               "issue_url": "https://api.github.com/repos/wlvh/SEC_metrics/issues/47",
+               "user": {"login": "wlvh"}, "body": text}
+    policy["delegation_body_sha256"] = sha256_bytes(content=text.encode("utf-8"))
+    (ROOT / FIXTURE_DIR).mkdir(parents=True, exist_ok=True)
+    (ROOT / RECORD_PATH).write_text(json.dumps(comment), encoding="utf-8")
+    (ROOT / calls.ALLOWANCE_PATH).write_text(json.dumps(policy), encoding="utf-8")
+    return comment
+
+
+def remove_allowance():
+    for relative in (calls.ALLOWANCE_PATH,):
+        (ROOT / relative).unlink(missing_ok=True)
+    shutil.rmtree(ROOT / FIXTURE_DIR, ignore_errors=True)
+
+
+def seal_fixture_receipt():
+    """A receipt over the current call path, for the live-path mechanics only.
+
+    The real receipt is sealed by the verification harness after this whole
+    suite has passed; this one lets the live-path tests exercise the check
+    that reads it.
+    """
+    bound = {}
+    for relative in calls.CALL_PATH_FILES:
+        raw = (ROOT / relative).read_bytes()
+        bound[relative] = {"sha256": sha256_bytes(content=raw), "size": len(raw)}
+    body = {"record_type": "ISSUE_47_MODEL_EGRESS_OFFLINE_VERIFICATION",
+            "requirement_id": calls.REQUIREMENT_ID, "all_checks_passed": True,
+            "calls": {"provider": 0, "paid": 0, "sec": 0}, "bound_files": bound,
+            "fixture": "RECORDED_TEST_ONLY"}
+    (ROOT / RECEIPT_PATH).write_text(json.dumps({**body, "receipt_id": content_hash(value=body)}),
+                                     encoding="utf-8")
+
+
+def wire(output, *, usage=True, prompt_tokens=100, model="deepseek-flash"):
+    value = {"id": "issue47-offline", "model": model,
+             "choices": [{"message": {"role": "assistant", "content": output.decode("utf-8")},
+                          "finish_reason": "stop"}]}
+    if usage:
+        value["usage"] = {"prompt_tokens": prompt_tokens, "completion_tokens": 20,
+                          "total_tokens": prompt_tokens + 20, "prompt_cache_hit_tokens": 0,
+                          "prompt_cache_miss_tokens": prompt_tokens}
+    return canonical_json_bytes(value=value)
+
+
+def reference_prompt_tokens(prepared):
+    """What the pinned reference tokenizer counts for this body - what a real service reports."""
+    from vnext.continuous_request_context import measure_request
+    return measure_request(prepared.provider_request_body_bytes)["input_tokens"]
+
+
+class _Response(io.BytesIO):
+    headers = {"x-request-id": "issue47-offline"}

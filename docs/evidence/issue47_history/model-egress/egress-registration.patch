+            repo_root=ROOT, requirement_id=calls.REQUIREMENT_ID)
+        cls.requests = calls.prepare_historical_requests(
+            company_id=COMPANY, metric_id="D04", period_selection=cls.selection,
+            authority=cls.authority, allowance=cls.allowance, data_root=ROOT)
+
+    @classmethod
+    def tearDownClass(cls):

+"""Issue #47's model egress, verified offline in a tree where the registration patch is applied.
+
+This suite is part of the patch for independent security review
+(docs/evidence/issue47_history/model-egress/). It runs only where
+``historical_model_egress`` exists and the three boundary files carry the
+patch; it opens no socket. DNS, raw sockets and SEC are refused for the whole
+run, and the one provider opener is replaced by a controlled one that asserts
+the exact URL, body and timeout before returning recorded bytes.
+
+The allowance and approval it uses are fixtures written into the tree for the
+run and removed after it. The approval's body says, in a field of its own,
+that it is a recorded test fixture and not an approval; the live path reads it
+only through a reader the test supplies. Outputs are the semantic route
+suite's synthetic fixtures - the frozen checker's own relations - so a
+registration made here proves the path from a counted call to the creator
+journal, never a filing's content.
+"""
+import atexit
+import dataclasses
+import io
+import json
+import os
+import shutil
+import signal
+import socket
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from urllib.error import HTTPError
+import importlib.util as _importlib_util
+
+# The owner's runner comes first, before anything of the checkout's, as it
+# does when the owner runs it: it makes this process's private bytecode cache,
+# and the call path refuses a socket in a process that compiled checkout code
+# anywhere else (historical_model_calls.loaded_code_holds). Loaded after the
+# imports below, it found them compiled into the harness's cache, and every
+# live case was refused - what a runner that imported the checkout before
+# making its cache would meet. So a process that already holds checkout code,
+# because another suite ran in it first, is refused here by name.
+_CHECKOUT = Path(__file__).resolve().parents[2]
+_ALREADY = sorted(
+    relative for module in list(sys.modules.values())
+    for where in [getattr(module, "__file__", None)] if where
+    for real in [Path(os.path.realpath(where))] if _CHECKOUT in real.parents
+    for relative in [real.relative_to(_CHECKOUT).as_posix()] if not relative.startswith("tests/"))
+if _ALREADY:
+    raise ImportError("ISSUE_47_EGRESS_SUITE_NEEDS_A_PROCESS_OF_ITS_OWN:" + ",".join(_ALREADY[:8]))
+_RUNNER_SPEC = _importlib_util.spec_from_file_location(
+    "vnext_historical_model", _CHECKOUT / "tools" / "vnext_historical_model.py")
+runner = _importlib_util.module_from_spec(_RUNNER_SPEC)
+_RUNNER_SPEC.loader.exec_module(runner)
+
+from tests.vnext.common import REPO_ROOT as ROOT  # noqa: E402 - after the runner, see above
+from tests.vnext.d04_synthetic_output import synthetic_output  # noqa: E402
+from vnext import ai_adapter as adapter  # noqa: E402
+from vnext import historical_model_calls as calls  # noqa: E402
+from vnext import historical_model_egress as egress  # noqa: E402
+from vnext import historical_semantic_results as semantic  # noqa: E402
+from vnext import invocation_control as control  # noqa: E402
+from vnext.canonical import (canonical_json_bytes, content_hash, sha256_bytes,  # noqa: E402
+                             strict_json_loads)
+from vnext.historical_event_items import CONFIRMATION_REASON  # noqa: E402
+from vnext.historical_zero_ai_results import (e01_confirmation_request,  # noqa: E402
+                                              resolve_historical_zero_ai_metric)
+from vnext.historical_text_input import (d02_review_request,  # noqa: E402
+                                         prepare_historical_business_text_input)
+from vnext.normal_period_selection import resolve_period_selection  # noqa: E402
+
+COMPANY, PERIOD, OTHER_PERIOD = "marriott_international", "2023-12-31", "2024-12-31"
+FIXTURE_DIR = "docs/evidence/issue47_history/model-egress/test-fixture"
+RECORD_PATH = FIXTURE_DIR + "/delegation.json"
+RECEIPT_PATH = FIXTURE_DIR + "/wiring-receipt.json"
+URL = "https://github.com/wlvh/SEC_metrics/issues/47#issuecomment-1000000001"
+TRANSPORT = {"provider": "deepseek", "model": "deepseek-flash", "api": "chat_completions",
+             "endpoint_host": adapter._DEEPSEEK_ENDPOINT_HOST,
+             "region": "provider-managed-no-residency-guarantee",
+             "retention": "provider-managed; no zero-retention claim",
+             "data_use": "provider-managed; no training or data-use guarantee",
+             "timeout_seconds": 120, "retry_count": 0, "maximum_payload_bytes": 8388608,
+             "filing_egress_policy": "PUBLIC_SEC_FILING_CONTENT_ONLY"}

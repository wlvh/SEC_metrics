+            _, outcome = egress.execute_historical_semantic(prepared=prepared, ledger=ledger)
+        self.assertEqual("SOURCE_AUTHENTICITY_FAILED", outcome["stop_reason"])
+        self.assertEqual([], self.opened)
+
+    def test_a_changed_call_path_refuses_the_live_ledger(self):
+        receipt = (ROOT / RECEIPT_PATH).read_bytes()
+        value = json.loads(receipt)
+        value["bound_files"][calls.CALL_PATH_FILES[1]]["sha256"] = "0" * 64
+        body = {k: v for k, v in value.items() if k != "receipt_id"}
+        (ROOT / RECEIPT_PATH).write_text(json.dumps({**body, "receipt_id": content_hash(value=body)}))
+        try:
+            with self.assertRaisesRegex(calls.HistoricalModelCallError,
+                                        "ISSUE_47_MODEL_WIRING_FILE_CHANGED"):
+                calls.live_model_ledger()
+        finally:
+            (ROOT / RECEIPT_PATH).write_bytes(receipt)
+
+
+class ACompleteAssessmentRegistersOnlyFromItsOwnSlots(_Isolated):
+    """Counted calls to the creator journal, in the ledger's own mode."""
+
+    def test_every_request_answered_registers_and_a_run_can_read_it(self):
+        ledger = self.recorded("complete")
+        slots = []
+        for prepared in self.requests:
+            path, outcome = egress.execute_historical_semantic(
+                prepared=prepared, ledger=ledger, recorded_wire=wire(self.output(prepared)))
+            self.assertEqual("SUCCEEDED", outcome["status"])
+            slots.append(path)
+        with self.assertRaisesRegex(Exception, "HISTORICAL_ASSESSMENT_OUTPUT_SET_DIFFERS"):
+            egress.register_from_slots(prepared_requests=self.requests[:-1], ledger=ledger,
+                                       slots=slots[:-1])
+        other = self.recorded("other")
+        with self.assertRaisesRegex(egress.HistoricalModelEgressError,
+                                    "ISSUE_47_MODEL_SLOT_IS_NOT_THIS_LEDGER_S"):
+            egress.register_from_slots(prepared_requests=self.requests, ledger=other, slots=slots)
+        record, path = egress.register_from_slots(prepared_requests=self.requests, ledger=ledger,
+                                                  slots=slots)
+        try:
+            self.assertEqual("RECORDED_TEST_ONLY", record["mode"])
+            source = semantic.pinned_native_source(repo_root=ROOT, company_id=COMPANY,
+                                                   metric_id="D04", period_selection=self.selection)
+            loaded = semantic.load_historical_assessment(data_root=ROOT, source=source,
+                                                         mode="RECORDED_TEST_ONLY")
+            self.assertEqual(record, loaded)
+            with self.assertRaisesRegex(semantic.HistoricalSemanticError,
+                                        "HISTORICAL_SEMANTIC_ASSESSMENT_NOT_REGISTERED:LIVE"):
+                semantic.load_historical_assessment(data_root=ROOT, source=source)
+        finally:
+            path.unlink()
+            for parent in path.parents:
+                if parent.name == "RECORDED_TEST_ONLY" or any(parent.iterdir()):
+                    break
+                parent.rmdir()
+
+    def test_a_failed_slot_cannot_complete_an_assessment(self):
+        ledger = self.recorded("with-a-failure")
+        broken = json.dumps({"request_id": "wrong", "units": []}).encode("utf-8")
+        slots = []
+        for index, prepared in enumerate(self.requests):
+            path, _ = egress.execute_historical_semantic(
+                prepared=prepared, ledger=ledger,
+                recorded_wire=wire(broken if index == 0 else self.output(prepared)))
+            slots.append(path)
+        with self.assertRaisesRegex(egress.HistoricalModelEgressError,
+                                    "ISSUE_47_MODEL_SLOT_DID_NOT_SUCCEED"):
+            egress.register_from_slots(prepared_requests=self.requests, ledger=ledger, slots=slots)
+

{"decisions": [{"block_id": "b732", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1018", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1042", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1061", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1063", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1066", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1111", "decision": "IN_SCOPE", "quote": "We self-insure for certain levels of liability, workers’ compensation, property insurance, and employee medical coverage. We accrue estimated costs of these self-insurance programs at the present value of projected settlements for known and incurred but not reported claims."}, {"block_id": "b1112", "decision": "IN_SCOPE", "quote": "Legal Contingencies"}, {"block_id": "b1113", "decision": "IN_SCOPE", "quote": "We are subject to various legal proceedings and claims, the outcomes of which are uncertain."}, {"block_id": "b1184", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1189", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1194", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1197", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1198", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1249", "decision": "OUT_OF_SCOPE", "quote": null}, {"block_id": "b1265", "decision": "OUT_OF_SCOPE", "quote": null}], "also_in_scope": [{"block_id": "b1110", "quote": "Self-Insurance Programs"}]}
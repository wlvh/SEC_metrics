{
 "an_eighth_defect_in_this_reading_and_it_read_as_missing_material": {
  "the_fix": "proxies are identified by form, from the saved submissions block, and the reading now separates three answers it used to collapse into one: the registrant declares no DEF 14A, the declared proxy is not saved, and the saved proxy does not report this period.",
  "the_shape": "a lookup that comes back empty reads exactly like a document with nothing in it. Before reporting an absence, the finder has to be shown finding something.",
  "two_more_attempts_that_failed_the_same_way": [
   "the first replacement read each accession directory's index.json for the form - those directories hold only the document and its response headers, so it found nothing for anybody and would have reported the same absence it was written to correct",
   "the diagnosis of that attempt was run against the output of a process started before the patch, so a stale file was read as the new code's result"
  ],
  "verdicts_after": {
   "enphase-2025": "MATCH",
   "ford-2025": "MATCH",
   "lumen-2025": "MATCH",
   "macys-2026": "MATCH",
   "marriott-2025": "MATCH",
   "pfizer-2025": "MATCH",
   "salesforce-2026": "MATCH",
   "southwest-2025": "MATCH"
  },
  "verdicts_before": {
   "enphase-2025": "NOT_READ",
   "ford-2025": "MATCH",
   "lumen-2025": "NOT_READ",
   "macys-2026": "MATCH",
   "marriott-2025": "MATCH",
   "pfizer-2025": "NOT_READ",
   "salesforce-2026": "NOT_READ",
   "southwest-2025": "MATCH"
  },
  "what_it_said": "four of eight C03 positions - Enphase, Lumen, Pfizer, Salesforce - reported NO_SAVED_PROXY_REPORTS_THE_TARGET_PERIOD, which reads as a material gap",
  "what_was_true": "all four proxies were saved and readable, carrying 76, 89, 138 and 82 ecd facts. The reading globbed *def14a*.htm inside each registrant's accession material directories, and exactly one of the ten companies names its proxy that way - Ford's e26003_f-def14a.htm. The rest use <ticker>-<date>.htm, so the glob could only ever find the ones that happened to be named for it."
 },
 "and_one_judgement_that_was_too_strict": {
  "what": "a PEO total tagged in a context naming the officer was treated as ambiguous and skipped.",
  "why_that_was_wrong": "it is still one number when there is only one of it. Marriott and Southwest each report exactly one PEO total for the target period, per officer, and both equal the published value. Ambiguity is several, not a dimension."
 },
 "c04_was_recorded_as_untriaged_and_this_closes_it": {
  "a_fourth_defect_stopped_before_it_shipped": {
   "how_it_was_caught": "the finder was asked for a document already known to contain the fact before its empty answers were believed: instance -> ['DELOITTE & TOUCHE LLP'].",
   "side_effect": "both sides now unescape HTML entities, so the recorded string moves from 'DELOITTE &amp; TOUCHE LLP' to 'DELOITTE & TOUCHE LLP'. The comparison is unchanged because both sides move together.",
   "what": "text_fact matched only <ix:nonNumeric>. An XBRL instance writes the fact as a plain element and has no ix:nonNumeric at all, so reading one returned an empty set - indistinguishable from a filing that names no auditor."
  },
  "macys_is_an_observation_not_a_defect": {
   "measured": "the target filing writes KPMG LLP and the prior one writes KPMG, LLP",
   "the_judgement": "a difference of punctuation and case is the same firm. Comparing the strings as filed would report a change of auditor that no reader of the two filings would agree with. Both exact strings are recorded beside the verdict so the judgement is visible rather than folded away.",
   "what_it_borrows": "this is the same normalisation the route uses, so if the route were too loose at this layer this reading would be too. Measured against that: the rule compares letter sequences, so KPMG and KPMG Advisory are not equal under it."
  },
  "one_more_limitation_worth_naming": "text_fact takes every dei:AuditorName fact in the document without filtering by context, entity or dimension, which is looser than the route. Each document here carries exactly one name, so there is no divergence to see in this corpus.",
  "result": "C04 MATCH 1 -> 6. Southwest and Salesforce have no published C04 value at all (withheld), so NO_PUBLISHED_VALUE is the right answer for them.",
  "the_fix_for_the_last_two_is_one_sentence": "do not recompute it - the period selection already carries prior_report_end and prior_filing, with the accession and the primary document name.",
  "three_defects_in_this_reading": [
   "it demanded the prior year's primary HTML. The route's _auditor_filing reads any document of that accession carrying dei facts, and Enphase's prior accession holds enph-20241231_htm.xml and index.json and no primary HTML at all.",
   "the prior accession was parsed out of an error string this reading had itself truncated to 140 characters - the URL breaks mid-accession, so the pattern could never match. The information was destroyed before it was read.",
   "the prior period end was produced by replacing the year in the target's. Macy's 2026-01-31 became 2025-01-31; its 52/53-week prior period ended 2025-02-01, a date its calendar never had."
  ],
  "what_it_said": "five positions reported PREVIOUS_YEARS_FILING_NOT_READABLE, which reads as missing material while the route produced a value for each of them"
 },

e":null},{"block_id":"b1958","decision":"IN_SCOPE","quote":"13. COMMITMENTS AND CONTINGENCIES"},{"block_id":"b2015","decision":"IN_SCOPE","quote":"The Company is subject to various legal proceedings and claims that have arisen in the ordinary course of business and that have not been fully resolved. An accrual for a loss contingency is recognized when it is probable and the amount of loss or recovery can be reasonably estimated."},{"block_id":"b2024","decision":"OUT_OF_SCOPE","quote":null},{"block_id":"b2254","decision":"OUT_OF_SCOPE","quote":null},{"block_id":"b2273","decision":"OUT_OF_SCOPE","quote":null},{"block_id":"b2280","decision":"OUT_OF_SCOPE","quote":null},{"block_id":"b2334","decision":"OUT_OF_SCOPE","quote":null},{"block_id":"b2335","decision":"OUT_OF_SCOPE","quote":null}],"also_in_scope":[]}
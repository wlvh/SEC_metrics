          ],
          "kind": "EXPLICIT_REFERENCE_YEARS",
          "mapping": [
            {
              "fiscal_year": 2025,
              "period_end": "2026-01-31"
            },
            {
              "fiscal_year": 2024,
              "period_end": "2025-02-01"
            },
            {
              "fiscal_year": 2023,
              "period_end": "2024-02-03"
            }
          ],
          "raw_end_byte": 218969,
          "raw_span_sha256": "94e2cd52a3633901cb10c3295c1d212839018271163548857ec9ece6b79a4166",
          "raw_start_byte": 218507,
          "text": "Unless the context requires otherwise, references to “Macy's, Inc.” or the “Company” are references to Macy's and its subsidiaries and references to “2025,” “2024,” and “2023” are references to the Company's fiscal years ended January 31, 2026, February 1, 2025 and February 3, 2024, respectively. Fiscal years 2025 and 2024 each included 52 weeks and fiscal year 2023 included 53 weeks."
        },
        {
          "block_index": 999,
          "current_period_labels": [
            2025
          ],
          "kind": "EXPLICIT_ORDERED_YEARS",
          "mapping": [
            {
              "fiscal_year": 2025,
              "period_end": "2026-01-31"
            },
            {
              "fiscal_year": 2024,
              "period_end": "2025-02-01"
            },
            {
              "fiscal_year": 2023,
              "period_end": "2024-02-03"
            }
          ],
          "raw_end_byte": 1011369,
          "raw_span_sha256": "a40f957ac150bfdc0ecf1eb5488b6f4f5890ac734b99719a1d59a6d632f0b16b",
          "raw_start_byte": 1010975,
          "text": "The Company's fiscal year ends on the Saturday closest to January 31. Fiscal years 2025, 2024 and 2023 ended on January 31, 2026, February 1, 2025 and February 3, 2024, respectively. Fiscal years 2025 and 2024 included 52 weeks and fiscal year 2023 included 53 weeks. References to years in the Consolidated Financial Statements relate to fiscal years rather than calendar years."
        }

179:    def test_completed_withheld_survives_read_after_another_metric_subset(self):
180:        """Constructed history control: a later subset cannot revive old success."""
181:        import copy
182:        import json
183:        from tests.vnext.test_company_current_records import CurrentCompanyTest
184:        from vnext import company_current_records as current
185:        from vnext.csv_output import METRIC_FIELDS, _csv_bytes
186:        fixture = CurrentCompanyTest()
187:        fixture.setUp()
188:        self.addCleanup(fixture.doCleanups)
189:        fixture.run_company(['B01'])
190:        prior = fixture.work/'updates/B01/results/first'
191:        state = fixture.work/'updates/B01/periods/FY2024'
192:        success = state/'results/success'; success.mkdir(parents=True)
193:        held = state/'results/held'; held.mkdir()
194:        old = copy.deepcopy(fixture.values[str(prior)])
195:        old['result'].update(period_start='2024-01-01', period_end='2024-12-31',
196:            result_id='constructed-old-success', value='100', publication='PUBLISHED')
197:        old['manifest']['target_period']['fiscal_year'] = 2024
198:        old['files']['metrics_matrix.csv'] = _csv_bytes(rows=[{
199:            **{f: '' for f in METRIC_FIELDS}, 'metric_id': 'B01', 'fiscal_year': '2024',
200:            'period_start': '2024-01-01', 'period_end': '2024-12-31',
201:            'value': '100', 'unit': 'USD', 'status': 'OK'}], fieldnames=METRIC_FIELDS)
202:        fixture.values[str(success)] = old
203:        new = copy.deepcopy(old)
204:        new['result'].update(result_id='constructed-current-withheld', value=None,
205:            publication='WITHHELD', unit=None, reason_code='CONSTRUCTED_CONTROL_BUSINESS_WITHHELD')
206:        new['files']['metrics_matrix.csv'] = _csv_bytes(rows=[{
207:            **{f: '' for f in METRIC_FIELDS}, 'metric_id': 'B01', 'fiscal_year': '2024',
208:            'period_start': '2024-01-01', 'period_end': '2024-12-31', 'status': 'WITHHELD'}],
209:            fieldnames=METRIC_FIELDS)
210:        fixture.values[str(held)] = new
211:        common = {'company_id': 'marriott_international', 'metric_id': 'B01',
212:            'requested_fiscal_year': 2024, 'period_end': '2024-12-31',
213:            'configuration': {'constructed_control': True}, 'source_census': []}
214:        (state/'current-result.json').write_text(json.dumps({**common,
215:            'version': 'success', 'result_id': old['result']['result_id']}))
216:        (state/'completed-check.json').write_text(json.dumps({**common,
217:            'version': 'held', 'result_id': new['result']['result_id'], 'status': 'CANDIDATE_WITHHELD'}))
218:        fixture.run_company(['B02'])
219:        view = current.read_current_company(state_root=fixture.work, company_id='marriott_international')
220:        row = next(r for r in view['metrics'] if r['metric_id'] == 'B01' and r['fiscal_year'] == 2024)
221:        self.assertFalse(row['requested_in_latest_execution'])
222:        self.assertIsNone(row['value'])
223:        self.assertEqual('WITHHELD', row['publication'])

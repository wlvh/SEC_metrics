345:def _run_saved_history(*, company_id, source_root, work_dir, output_dir, metric_ids,
346:                       fiscal_year_start, fiscal_year_end):
347:    """Select saved issuer years; the shared company controller owns processing.
348:
349:    Historical acquisition and unsupported families retain their existing
350:    entry. No source installation or old native-task mutation occurs here.
351:    """
352:    need(type(fiscal_year_start) is int and type(fiscal_year_end) is int
353:         and 1900 <= fiscal_year_start <= fiscal_year_end <= 9998
354:         and fiscal_year_end-fiscal_year_start < 5, 'COMPANY_HISTORY_FISCAL_RANGE_INVALID')
355:    need(source_root is not None, 'LOCAL_HISTORY_PREPARED_SOURCE_REQUIRED')
356:    from .historical_lodging_results import (SUPPORTED_METRICS,
357:        prepare_historical_lodging_year_case, HISTORICAL_LODGING_PROCESSING_FILES)
358:    from .historical_statement_cases import (METRICS as statement_metrics,
359:        prepare_historical_statement_year_case, PROCESSING_FILES as statement_files,
360:        INCOME_PROCESSING_FILES as income_files)
361:    from .historical_statement_cases import prepare_historical_current_annual_year_case
362:    from .historical_liquidity_cases import (METRICS as liquidity_metrics,
363:        prepare_historical_liquidity_year_case, PROCESSING_FILES as liquidity_files)
364:    from .historical_event_cases import (METRICS as event_metrics,
365:        prepare_historical_event_year_case, PROCESSING_FILES as event_files)
366:    from .historical_capital_cases import (METRICS as capital_metrics,
367:        prepare_historical_capital_year_case, PROCESSING_FILES as capital_files)
368:    from .historical_bank_performance_cases import (METRICS as bank_metrics,
369:        prepare_historical_bank_year_case, PROCESSING_FILES as bank_files)
370:    from .historical_geography_cases import (METRICS as geography_metrics,
371:        prepare_historical_geography_year_case, PROCESSING_FILES as geography_files)
372:    from .historical_average_risk_cases import (METRICS as average_risk_metrics,
373:        prepare_historical_average_risk_year_case, PROCESSING_FILES as average_risk_files)
374:    from .historical_bank_scope_cases import (METRICS as bank_scope_metrics,
375:        prepare_historical_bank_scope_year_case, PROCESSING_FILES as bank_scope_files)
376:    from .historical_rpo_cases import (METRICS as rpo_metrics,
377:        prepare_historical_rpo_year_case, PROCESSING_FILES as rpo_files)
378:    selected = configured_scope(company_id) if metric_ids is None else list(metric_ids)
379:    need(selected and len(selected) == len(set(selected))
380:         and set(selected) <= set(SUPPORTED_METRICS) | set(statement_metrics) | set(liquidity_metrics) | set(capital_metrics) | set(bank_metrics) | set(event_metrics) | set(geography_metrics) | set(average_risk_metrics) | set(bank_scope_metrics) | set(rpo_metrics) | {'B07'},
381:         'LOCAL_HISTORY_SAVED_FAMILY_NOT_IMPLEMENTED: select received saved families; other history uses its original entry')
382:    from .company_current_records import run_saved_company
383:    if set(selected) <= {'B01','B02'}:
384:        from .company_fiscal_range import range_case_factories, PROCESSING_FILES as range_files
385:        years=list(range(fiscal_year_start,fiscal_year_end+1))
386:        factories=range_case_factories(company_id=company_id,fiscal_years=years,
387:            metric_ids=selected,case_factories={m:prepare_historical_statement_year_case for m in selected})
388:        return run_saved_company(company_id=company_id,source_root=source_root,
389:            work_dir=work_dir,output_dir=output_dir,metric_ids=selected,fiscal_years=years,
390:            case_factories=factories,processing_files_by_metric={m:tuple(dict.fromkeys(
391:                (*income_files,*range_files))) for m in selected})
392:    if not set(selected) <= set(SUPPORTED_METRICS):
393:        return run_saved_company(company_id=company_id, source_root=source_root,
394:            work_dir=work_dir, output_dir=output_dir, metric_ids=selected,
395:            fiscal_years=list(range(fiscal_year_start, fiscal_year_end+1)),
396:            case_factories={m: (prepare_historical_rpo_year_case if m in rpo_metrics else
397:                               prepare_historical_event_year_case if m in event_metrics else
398:                               prepare_historical_geography_year_case if m in geography_metrics else
399:                               prepare_historical_average_risk_year_case if m in average_risk_metrics else
400:                               prepare_historical_bank_scope_year_case if m in bank_scope_metrics else
401:                               prepare_historical_current_annual_year_case if m == 'B07' else
402:                               prepare_historical_bank_year_case if m in bank_metrics else
403:                               prepare_historical_capital_year_case if m in capital_metrics else
404:                               prepare_historical_liquidity_year_case if m in liquidity_metrics else
405:                               prepare_historical_lodging_year_case if m in SUPPORTED_METRICS
406:                               else prepare_historical_statement_year_case) for m in selected},
407:            processing_files_by_metric={m: (rpo_files if m in rpo_metrics else
408:                                            event_files if m in event_metrics else
409:                                            geography_files if m in geography_metrics else
410:                                            average_risk_files if m in average_risk_metrics else
411:                                            bank_scope_files if m in bank_scope_metrics else
412:                                            statement_files if m == 'B07' else
413:                                            bank_files if m in bank_metrics else
414:                                            capital_files if m in capital_metrics else
415:                                            liquidity_files if m in liquidity_metrics else
416:                                            HISTORICAL_LODGING_PROCESSING_FILES if m in SUPPORTED_METRICS
417:                                            else income_files if m in {'B01','B02'}
418:                                            else statement_files) for m in selected})
419:    return run_saved_company(company_id=company_id, source_root=source_root,
420:        work_dir=work_dir, output_dir=output_dir, metric_ids=selected,
421:        fiscal_years=list(range(fiscal_year_start, fiscal_year_end+1)),
422:        case_factory=prepare_historical_lodging_year_case,
423:        processing_files=HISTORICAL_LODGING_PROCESSING_FILES)


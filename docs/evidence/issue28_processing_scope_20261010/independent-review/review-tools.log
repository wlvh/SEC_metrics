45: def _validate_records(records, company_id, metric_id, result_id):
46:     for record in records:
47:         validate_record(record=record)
48:     results = [r for r in records if r['record_type'] == 'METRIC_RESULT'
49:                and r['metric_id'] == metric_id]
50:     _need(len(results) == 1 and results[0]['company_id'] == company_id
51:           and results[0]['result_id'] == result_id, 'SAVED_RESULT_COORDINATE_CHANGED')
52:     traces = [r for r in records if r['record_type'] == 'EXECUTION_TRACE'
53:               and r['trace_id'] == results[0]['trace_id']]
54:     _need(len(traces) == 1, 'SAVED_RESULT_TRACE_MISSING')
55:     return results[0]

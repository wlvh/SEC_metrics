32:     paths = set(policy['rule_paths']) | set(policy['presentation_paths'])
33:     # Ordinary records verify saved inputs directly, without registering a
34:     # legacy RecordedSourceSession. Consumers that actually use that session
35:     # may still name it explicitly in run_once(processing_files=...).
36:     paths.discard('scripts/vnext/ordinary_source_session.py')
37:     # These files belong solely to the lodging producer. The zero-AI Spec
38:     # set never prepares a lodging case; unrelated edits must not recalculate
39:     # B01/B02 or their other supported deterministic neighbours.
40:     if metric in METRIC_IDS:
41:         paths.add('scripts/vnext/zero_ai_r2.py')
42:         paths.difference_update({'scripts/vnext/normal_lodging_results.py',
43:             'scripts/vnext/lodging_table_source.py', 'config/ordinary_lodging_table_v1.json',
44:             'catalog/ordinary_lodging/B10.md', 'catalog/ordinary_lodging/B11.md'})
45:     paths.update({'scripts/vnext/ordinary_current_update.py','scripts/vnext/ordinary_saved_result.py',
46:                   'scripts/vnext/csv_output.py','scripts/vnext/ordinary_update_compatibility.py',
47:                   'config/issue28_normal_results_v2.json'})
48:     # The old Requirement inherited these dependencies implicitly. Ordinary
49:     # records must name their actual shared parser/calculator dependencies.
50:     paths.update('scripts/vnext/'+name+'.py' for name in (
51:         'deterministic_router','calculator','canonical','records','observations',
52:         'specs','sources','table_grid','resource_limits','traits','projector',
53:         'governance_signals','annual_input','annual_sources','deterministic_catalog',
54:         'saved_source_checks','request_bindings','company_registry',
55:         'normal_annual_input'))
56:     # Current producers import only ROOT from normal_source_authority; its
57:     # historical admission gates do not process this ordinary input. Actual
58:     # request/body checks are covered by saved_source_checks above.
59:     paths.update({'catalog/company_traits.yaml','config/metric_applicability.yaml',
60:                   'config/company_registry.csv'})
61:     if metric == 'B02':
62:         paths.add('scripts/vnext/paired_measure_v1.py')
63:     if metric in {'B01','B03'}:
64:         paths.update('scripts/vnext/'+name+'.py' for name in (
65:             'selected_revenue_scope_v1','selected_reported_revenue_v2','selected_income_source_v1',
66:             'historical_fiscal_labels','financial_structured',

271:                 saved = save_calculated_case(source_root=source,output_root=root/'results'/version,
272:                     company_id=company_id,metric_id=metric_id,case=case,shared_input_root=shared_input_root)
273:             if previous:
274:                 _need(saved['result']['period_end']>=previous['period_end'], 'CURRENT_UPDATE_PERIOD_REGRESSED')
275:             state={'company_id':company_id,'metric_id':metric_id,'version':version,
276:                    'period_end':saved['result']['period_end'],'configuration':configuration,
277:                    'result_id':saved['result']['result_id'],'source_census':census}
278:             if fiscal_year is not None:state['requested_fiscal_year']=fiscal_year
279:             report={'status':'CANDIDATE_READY' if saved['result']['publication']=='PUBLISHED' else 'CANDIDATE_WITHHELD',
280:                     'attempt_id':identity,'version':version,'result_id':saved['result']['result_id'],
281:                     'result_root':str(root/'results'/version),'calculation_performed':True,'new_candidate_created':True,
282:                     'result_reason_code':saved['result'].get('reason_code'),
283:                     'source_observation_errors':source_errors,
284:                     'new_calls':{'provider':0,'paid':0,'sec':0},'production_authorized':False}
285:             if fiscal_year is not None:report['requested_fiscal_year']=fiscal_year
286:             if report['status']=='CANDIDATE_READY': report['completed_state']=state
287:             report['completed_check']={**state,'status':report['status']}
288:             _write(attempt/'terminal.json',report)
289:             if report['status']=='CANDIDATE_READY': _write(pointer,state)
290:             _write(root/'completed-check.json',report['completed_check'])
291:             _write(root/'latest-check.json',report)
292:             return {k:v for k,v in report.items() if k not in {'completed_state','completed_check'}}
293:         except Exception as error:

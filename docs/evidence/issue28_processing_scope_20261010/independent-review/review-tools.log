200:         if previous:
201:             _need(previous['company_id']==company_id and previous['metric_id']==metric_id,
202:                   'CURRENT_UPDATE_WRONG_HISTORY_COORDINATE')
203:         identity = uuid4().hex; attempt = root/'checks'/identity
204:         _write(attempt/'intent.json',{'attempt_id':identity,'company_id':company_id,'metric_id':metric_id,
205:                                     'previous_result':previous,'previous_check':completed})

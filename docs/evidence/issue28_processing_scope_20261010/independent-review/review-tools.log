82: def _current_sources(source, proofs):
83:     from sec_http import request_log_attempt_id
84:     from .request_bindings import validate_request_attempt_binding
85:     latest = {row['source_url']:(i,row) for i,row in enumerate(_rows(source)) if row['method']=='GET'}
86:     rows = []
87:     for old in proofs:
88:         current=latest.get(old['source_url'])
89:         _need(current is not None,'CURRENT_UPDATE_SOURCE_MISSING:'+old['source_url'])
90:         index,row=current
91:         _need(row['status_code']=='200' and not row['error'],'LATEST_SOURCE_REQUEST_FAILED:'+old['source_url'])
92:         # Pin the actual latest row. Repeated identical legacy GETs are valid,
93:         # but the convenience selector deliberately cannot disambiguate them.
94:         # This verifier still checks that row's exact body and header bytes.
95:         validate_request_attempt_binding(repo_root=source,source_url=old['source_url'],
96:             accession=old['accession'],document_name=row['document_name'],content_sha256=row['content_sha256'],
97:             request_attempt_id=request_log_attempt_id(row_index=index,row=row),require_immutable=False)
98:         rows.append({'source_url':old['source_url'],'accession':old['accession'],
99:                      'document_name':row['document_name'],'content_sha256':row['content_sha256']})
100:     return rows
101: 
102: 
103: def _source_census(source, company):
104:     """Keep newly acquired company files and failures visible, including events."""
105:     from .annual_sources import _rows
106:     ciks = set(repository_company_ciks(repo_root=source,company_id=company))
107:     latest = {}
108:     for row in _rows(source):
109:         path = urlsplit(row['source_url']).path
110:         archive = re.search(r'/data/(\d+)/',path)
111:         metadata = re.search(r'CIK(\d+)(?:[.-])',path)
112:         found = archive or metadata
113:         if row['method']=='GET' and found and str(int(found.group(1))) in ciks:
114:             latest[row['source_url']] = {k:row[k] for k in ('source_url','status_code','error','content_sha256','document_name')}
115:     return [latest[url] for url in sorted(latest)]
116: 
117: 
118: def _recover(root):
119:     """Incomplete checks cannot look complete; finish a saved pointer commit."""
120:     pointer = root/'current-result.json'
121:     current = strict_json_file(path=pointer) if pointer.is_file() else None
122:     ready = []
123:     for path in (root/'checks').glob('*/intent.json'):
124:         intent = strict_json_file(path=path); terminal = path.with_name('terminal.json')
125:         if not terminal.is_file():
126:             _write(terminal,{'status':'INTERRUPTED','attempt_id':intent['attempt_id'],
127:                             'previous_result':intent['previous_result'],'new_calls':{'provider':0,'paid':0,'sec':0}})
128:         else:
129:             report = strict_json_file(path=terminal)
130:             if report['status']=='CANDIDATE_READY' and report.get('completed_state'):
131:                 ready.append((intent,report))
132:     while True:
133:         following = [(i,r) for i,r in ready if i['previous_result']==current
134:                      and r['completed_state']!=current]
135:         if not following: break
136:         _need(len(following)==1,'CURRENT_UPDATE_JOURNAL_BRANCH')
137:         intent,report=following[0]; state=report['completed_state']
138:         saved=read_saved_result(output_root=root/'results'/state['version'])
139:         _need(saved['result']['result_id']==state['result_id']
140:               and saved['manifest']['company_id']==state['company_id']
141:               and saved['manifest']['metric_id']==state['metric_id'],'CURRENT_UPDATE_RECOVERY_RECORD_CHANGED')
142:         _write(pointer,state);current=state;ready.remove((intent,report))
143:     return current
144: 

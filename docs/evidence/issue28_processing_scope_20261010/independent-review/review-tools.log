26: def _program_version(root):
27:     """Version information for diagnosis, never a clean-tree admission gate."""
28:     def git(*args):
29:         completed = subprocess.run(['git', '-C', str(root), *args], capture_output=True, text=True)
30:         return completed.stdout.strip() if completed.returncode == 0 else None
31:     return {'commit': git('rev-parse', 'HEAD'),
32:             'has_uncommitted_changes': bool(git('status', '--porcelain'))}

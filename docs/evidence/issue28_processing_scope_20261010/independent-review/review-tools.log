228:                 _need(saved['manifest']['company_id']==company_id and saved['manifest']['metric_id']==metric_id,
229:                       'CURRENT_UPDATE_SAVED_COORDINATE_CHANGED')
230:                 _need(saved['result']['result_id']==comparison['result_id'],
231:                       'CURRENT_UPDATE_COMPLETED_RESULT_ID_CHANGED')
232:                 current = _current_sources(source,saved['manifest']['source_proofs'])

FILE tests/required_unittests.py
1: """Run required unittest modules and fail on unexpected skips.
2: 
3: CI jobs that restore inherited source-material coverage need a material
4: root; without it several classes are skipped and unittest still exits 0.
5: This runner counts what actually executed so a skip cannot pass as coverage.
6: """
7: import argparse
8: import json
9: from pathlib import Path
10: import sys
11: import unittest
12: 
13: # Run as `python3 tests/required_unittests.py`: replace the script directory
14: # (which would shadow `vnext` with `tests/vnext`) by the repository root, as
15: # `python3 -m unittest` from the repository root would.
16: sys.path[0] = str(Path(__file__).resolve().parents[1])
17: 
18: 
19: def main(argv=None):
20:     parser = argparse.ArgumentParser(description=__doc__)
21:     parser.add_argument('--allow-skips', type=int, default=0,
22:                         help='Skips that already existed in the original workflow')
23:     parser.add_argument('names', nargs='+')
24:     args = parser.parse_args(argv)
25:     suite = unittest.defaultTestLoader.loadTestsFromNames(args.names)
26:     result = unittest.TextTestRunner(verbosity=2).run(suite)
27:     summary = {'tests': args.names, 'run': result.testsRun,
28:                'failures': len(result.failures), 'errors': len(result.errors),
29:                'skipped': len(result.skipped), 'allowed_skips': args.allow_skips,
30:                'skip_reasons': [reason for _, reason in result.skipped]}
31:     print(json.dumps(summary, sort_keys=True))
32:     ok = (result.wasSuccessful() and result.testsRun > 0
33:           and len(result.skipped) <= args.allow_skips)
34:     return 0 if ok else 1
35: 
36: 
37: if __name__ == '__main__':
38:     sys.exit(main())


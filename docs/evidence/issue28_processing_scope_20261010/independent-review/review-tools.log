146: def _recover_completed_check(root):
147:     """Recover a finished conclusion separately from the last good result."""
148:     pointer=root/'completed-check.json'
149:     current=strict_json_file(path=pointer) if pointer.is_file() else None
150:     pending=[]
151:     for path in (root/'checks').glob('*/intent.json'):
152:         terminal=path.with_name('terminal.json')
153:         if terminal.is_file():
154:             report=strict_json_file(path=terminal)
155:             if report.get('completed_check') is not None:
156:                 pending.append((strict_json_file(path=path),report))
157:     while True:
158:         following=[(i,r) for i,r in pending if i.get('previous_check')==current
159:                    and r['completed_check']!=current]
160:         if not following:break
161:         _need(len(following)==1,'CURRENT_UPDATE_COMPLETED_CHECK_BRANCH')
162:         intent,report=following[0];state=report['completed_check']
163:         saved=read_saved_result(output_root=root/'results'/state['version'])
164:         expected='PUBLISHED' if state['status']=='CANDIDATE_READY' else 'WITHHELD'
165:         _need(state['status'] in {'CANDIDATE_READY','CANDIDATE_WITHHELD'}
166:               and saved['result']['publication']==expected
167:               and saved['result']['result_id']==state['result_id']
168:               and saved['manifest']['company_id']==state['company_id']
169:               and saved['manifest']['metric_id']==state['metric_id'],
170:               'CURRENT_UPDATE_COMPLETED_CHECK_RECORD_CHANGED')
171:         _write(pointer,state);current=state;pending.remove((intent,report))
172:     return current

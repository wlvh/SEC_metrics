+    def test_bank_consumers_declare_the_actual_fiscal_text_readers(self):
+        from pathlib import Path
+        from tests.vnext.processing_dependency_checks import processing_calls, assert_processing_calls
+        from vnext.ordinary_current_update import _configuration
+        from vnext import historical_average_risk_cases as average, historical_bank_scope_cases as bank
+        root=Path(__file__).resolve().parents[2]
+        with processing_calls(root) as observed:
+            result=self.resolve()
+        self.assertEqual(2021,result['selected_fiscal_year'])
+        paths=('scripts/vnext/text_coverage.py','scripts/vnext/text_results_v2.py')
+        for path in paths:
+            self.assertIn(path,observed)
+        # The same annual label reader is used by each of these consumers.
+        # It parses the real small DEI/body fixture, not a mocked label result.
+        for metric,consumer in (('A03',average),('A12',average),
+                                ('A04',bank),('A09',bank),('A11',bank)):
+            with self.subTest(metric=metric):
+                configuration=_configuration(root,'jpmorgan_chase',metric)
+                assert_processing_calls(observed,configuration,consumer.PROCESSING_FILES)
+                for path in paths:
+                    without=tuple(p for p in consumer.PROCESSING_FILES if p!=path)
+                    with self.assertRaisesRegex(AssertionError,path.split('/')[-1]):
+                        assert_processing_calls(observed,configuration,without)
+

+    def test_bank_fiscal_text_changes_process_once_then_reuse(self):
+        from vnext import historical_average_risk_cases as average, historical_bank_scope_cases as bank
+        original_hash=update.sha256_file
+        for metric,consumer in (('A03',average),('A12',average),
+                                ('A04',bank),('A09',bank),('A11',bank)):
+            for year,name in enumerate(('text_coverage','text_results_v2'),2021):
+                with self.subTest(metric=metric,module=name):
+                    self.forbid_factory=False
+                    first=self.run_control(year,metric,consumer.PROCESSING_FILES)
+                    count=len(self.factory_calls)
+                    self.forbid_factory=True
+                    self.assertEqual('NO_SOURCE_CONTENT_CHANGE',
+                        self.run_control(year,metric,consumer.PROCESSING_FILES)['status'])
+                    target=ROOT/('scripts/vnext/'+name+'.py')
+                    def changed_hash(*,path):
+                        return 'CONSTRUCTED_BANK_FISCAL_TEXT_CHANGE' if path==target else original_hash(path=path)
+                    self.forbid_factory=False
+                    with patch.object(update,'sha256_file',side_effect=changed_hash):
+                        changed=self.run_control(year,metric,consumer.PROCESSING_FILES)
+                        self.assertEqual('CANDIDATE_READY',changed['status'])
+                        self.assertTrue(changed['calculation_performed'])
+                        self.assertEqual(count+1,len(self.factory_calls))
+                        self.assertNotEqual(first['version'],changed['version'])
+                        self.forbid_factory=True
+                        repeat=self.run_control(year,metric,consumer.PROCESSING_FILES)
+                        self.assertEqual('NO_SOURCE_CONTENT_CHANGE',repeat['status'])
+                        self.assertEqual(changed['version'],repeat['version'])
+                    self.assertEqual(count+1,len(self.factory_calls))
+

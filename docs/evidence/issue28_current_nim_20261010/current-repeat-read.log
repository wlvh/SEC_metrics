ROWS [{"company": "JPMorgan Chase", "cik": "19617", "metric_id": "A04", "metric_name": "Net interest margin", "value": "0.025", "unit": "ratio", "status": "MDA_OK", "source_class": "MDA", "formula": "source-disclosed managed net interest margin", "period_start": "2025-01-01", "period_end": "2025-12-31", "fiscal_year": "2025", "fiscal_period": "ANNUAL", "accession": "0001628280-26-008131", "form": "10-K", "filed_date": "2026-02-13", "concept_or_section": "Managed net interest margin", "context_or_dimension": "{\"annual_filing_period\": {\"fiscal_year\": 2025, \"period_end\": \"2025-12-31\", \"period_start\": \"2025-01-01\"}, \"measurement_kind\": \"ANNUAL\", \"scope\": {\"basis\": \"managed_basis\"}, \"selection\": {\"classification\": \"VERIFIED_SOURCE_FACT\", \"reason_code\": \"PASS\", \"source_fact\": {\"calls\": {\"paid\": 0, \"provider\": 0, \"sec\": 0}, \"issuer_identity\": {\"native_name_facts\": [{\"context_ref\": \"c-1\", \"entity_cik\": \"19617\", \"name\": \"JPMorgan Chase & Co\", \"namespace\": \"http://xbrl.sec.gov/dei/2025\", \"ordinal\": 67, \"qualified_name\": \"dei:EntityRegistrantName\"}], \"normalization\": \"EXACT_TOKENS_CASE_PUNCTUATION_AND_AMPERSAND_ONLY\", \"registrant_name\": \"JPMorgan Chase & Co\", \"source_consolidated_aliases\": [{\"alias\": \"Firm\", \"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 5238225, \"inside_table\": false, \"span_sha256\": \"b30f1bb75f06fb6f9e6a9634b00094f0fe8bae4f8a836ca53bed45c4fe86627a\", \"start_byte\": 5237066, \"structure_path\": [\"html:1\", \"body:1\", \"div:932\", \"div:1\", \"div:4\"], \"tag\": \"div\", \"visible_text\": \"We have audited the accompanying consolidated balance sheets of JPMorgan Chase & Co. and its subsidiaries (the “Firm”) as of December 31, 2025 and 2024, and the related consolidated statements of income, comprehensive income, changes in stockholders’ equity and cash flows for each of the three years in the period ended December 31, 2025, including the related notes (collectively referred to as the “consolidated financial statements”). We also have audited the Firm’s internal control over financial reporting as of December 31, 2025, based on criteria established in Internal Control - Integrated Framework (2013) issued by the Committee of Sponsoring Organizations of the Treadway Commission (COSO).\"}, \"entity_scope\": \"REGISTRANT_AND_SUBSIDIARIES\"}], \"source_defined_aliases\": [{\"alias\": \"Firm\", \"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 1283602, \"inside_table\": false, \"span_sha256\": \"ae5028db86909092a0529dd591624124f07ad6c444181ae75a4eb8475d8340b2\", \"start_byte\": 1282663, \"structure_path\": [\"html:1\", \"body:1\", \"div:45\", \"div:1\", \"div:2\"], \"tag\": \"div\", \"visible_text\": \"JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”, NYSE: JPM), a financial holding company incorporated under Delaware law in 1968, is a leading financial services firm based in the United States of America (“U.S.”), with operations worldwide. JPMorganChase had $4.4 trillion in assets and $362.4 billion in stockholders’ equity as of December 31, 2025. The Firm is a leader in investment banking, financial services for consumers and small businesses, commercial banking, financial transaction processing and asset management. Under the J.P. Morgan and Chase brands, the Firm serves millions of customers, predominantly in the U.S., and many of the world’s most prominent corporate, institutional and government clients globally.\"}}, {\"alias\": \"Firm\", \"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 2041882, \"inside_table\": false, \"span_sha256\": \"2cd6a197d781d76d20af9ac54a250a85a96380dadbb3595539fa65f9a2be7784\", \"start_byte\": 2040911, \"structure_path\": [\"html:1\", \"body:1\", \"div:248\"], \"tag\": \"div\", \"visible_text\": \"The following table and graph compare the five-year cumulative total return for JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”) common stock with the cumulative return of the S&P 500 Index, the KBW Bank Index and the S&P Financials Index. The S&P 500 Index is a commonly referenced equity benchmark in the United States of America (“U.S.”), consisting of leading companies from different economic sectors. The KBW Bank Index seeks to reflect the performance of banks and thrifts that are publicly traded in the U.S. and is composed of leading national money center and regional banks and thrifts. The S&P Financials Index is an index of financial companies, all of which are components of the S&P 500. The Firm is a component of all three industry indices.\"}}, {\"alias\": \"Firm\", \"definition\": {\"attributes\": [[\"style\", \"margin-bottom:6pt\"]], \"end_byte\": 5230790, \"inside_table\": false, \"span_sha256\": \"3c570379f6a8ceaf7afd4210664351d562e397d19932a8ba6b64d05c99632d2e\", \"start_byte\": 5229880, \"structure_path\": [\"html:1\", \"body:1\", \"div:928\", \"div:1\", \"div:1\"], \"tag\": \"div\", \"visible_text\": \"Management of JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”) is responsible for establishing and maintaining adequate internal control over financial reporting. Internal control over financial reporting is a process designed by, or under the supervision of, the Firm’s principal executive and principal financial officers, or persons performing similar functions, and effected by JPMorganChase’s Board of Directors, management and other personnel, to provide reasonable assurance regarding the reliability of financial reporting and the preparation of financial statements for external purposes in accordance with accounting principles generally accepted in the United States of America (“U.S. GAAP”).\"}}, {\"alias\": \"Firm\", \"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 5238225, \"inside_table\": false, \"span_sha256\": \"b30f1bb75f06fb6f9e6a9634b00094f0fe8bae4f8a836ca53bed45c4fe86627a\", \"start_byte\": 5237066, \"structure_path\": [\"html:1\", \"body:1\", \"div:932\", \"div:1\", \"div:4\"], \"tag\": \"div\", \"visible_text\": \"We have audited the accompanying consolidated balance sheets of JPMorgan Chase & Co. and its subsidiaries (the “Firm”) as of December 31, 2025 and 2024, and the related consolidated statements of income, comprehensive income, changes in stockholders’ equity and cash flows for each of the three years in the period ended December 31, 2025, including the related notes (collectively referred to as the “consolidated financial statements”). We also have audited the Firm’s internal control over financial reporting as of December 31, 2025, based on criteria established in Internal Control - Integrated Framework (2013) issued by the Committee of Sponsoring Organizations of the Treadway Commission (COSO).\"}, \"entity_scope\": \"REGISTRANT_AND_SUBSIDIARIES\"}, {\"alias\": \"Firm\", \"definition\": {\"attributes\": [[\"style\", \"margin-bottom:6pt\"]], \"end_byte\": 5580397, \"inside_table\": false, \"span_sha256\": \"65fcb011d34c65a0fff6fc92ee45b331ffff0c22450b420eb4dad028c3de821c\", \"start_byte\": 5579756, \"structure_path\": [\"html:1\", \"body:1\", \"ix:continuation:2\", \"div:1\", \"div:1\", \"div:1\"], \"tag\": \"div\", \"visible_text\": \"JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”), a financial holding company incorporated under Delaware law in 1968, is a leading financial services firm based in the U.S., with operations worldwide. The Firm is a leader in investment banking, financial services for consumers and small businesses, commercial banking, financial transaction processing and asset management. Refer to Note 32 for further discussion of the Firm's reportable business segments.\"}}], \"source_defined_other_entities\": [{\"alias\": \"JPMorgan Chase Bank, N.A.\", \"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 1284570, \"inside_table\": false, \"span_sha256\": \"2274adbd5b31e9aed4bbcaf547581978992eabde19bdd6f17c5543a47b4fc8bc\", \"start_byte\": 1283602, \"structure_path\": [\"html:1\", \"body:1\", \"div:45\", \"div:1\", \"div:3\"], \"tag\": \"div\", \"visible_text\": \"JPMorganChase’s principal bank subsidiary is JPMorgan Chase Bank, National Association (“JPMorgan Chase Bank, N.A.”), a national banking association with U.S. branches in 48 states and Washington, D.C. JPMorganChase’s principal non-bank subsidiary is J.P. Morgan Securities LLC (“J.P. Morgan Securities”), a U.S. broker-dealer. The bank and non-bank subsidiaries of JPMorganChase operate nationally as well as through overseas branches and subsidiaries, representative offices and subsidiary foreign banks. The Firm’s principal operating subsidiaries outside the U.S. are J.P. Morgan Securities plc and J.P. Morgan SE (“JPMSE”), which are subsidiaries of JPMorgan Chase Bank, N.A. and are based in the United Kingdom (“U.K.”) and Germany, respectively.\"}, \"legal_name\": \"JPMorgan Chase Bank, National Association\", \"owner\": \"JPMorganChase\", \"relationship\": \"EXPLICIT_SUBSIDIARY_OF_REGISTRANT\"}, {\"alias\": \"J.P. Morgan Securities\", \"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 1284570, \"inside_table\": false, \"span_sha256\": \"2274adbd5b31e9aed4bbcaf547581978992eabde19bdd6f17c5543a47b4fc8bc\", \"start_byte\": 1283602, \"structure_path\": [\"html:1\", \"body:1\", \"div:45\", \"div:1\", \"div:3\"], \"tag\": \"div\", \"visible_text\": \"JPMorganChase’s principal bank subsidiary is JPMorgan Chase Bank, National Association (“JPMorgan Chase Bank, N.A.”), a national banking association with U.S. branches in 48 states and Washington, D.C. JPMorganChase’s principal non-bank subsidiary is J.P. Morgan Securities LLC (“J.P. Morgan Securities”), a U.S. broker-dealer. The bank and non-bank subsidiaries of JPMorganChase operate nationally as well as through overseas branches and subsidiaries, representative offices and subsidiary foreign banks. The Firm’s principal operating subsidiaries outside the U.S. are J.P. Morgan Securities plc and J.P. Morgan SE (“JPMSE”), which are subsidiaries of JPMorgan Chase Bank, N.A. and are based in the United Kingdom (“U.K.”) and Germany, respectively.\"}, \"legal_name\": \"J.P. Morgan Securities LLC\", \"owner\": \"JPMorganChase\", \"relationship\": \"EXPLICIT_SUBSIDIARY_OF_REGISTRANT\"}, {\"alias\": \"JPMorgan Chase Bank, N.A.\", \"definition\": {\"attributes\": [], \"end_byte\": 2064395, \"inside_table\": false, \"span_sha256\": \"97388f5f588db903c025b2fff0e180757fd090b8e8698c06110f1290cf293af1\", \"start_byte\": 2063453, \"structure_path\": [\"html:1\", \"body:1\", \"div:263\", \"div:1\", \"div:2\"], \"tag\": \"div\", \"visible_text\": \"JPMorganChase’s principal bank subsidiary is JPMorgan Chase Bank, National Association (“JPMorgan Chase Bank, N.A.”), a national banking association with U.S. branches in 48 states and Washington, D.C. JPMorganChase’s principal non-bank subsidiary is J.P. Morgan Securities LLC (“J.P. Morgan Securities”), a U.S. broker-dealer. The bank and non-bank subsidiaries of JPMorganChase operate nationally as well as through overseas branches and subsidiaries, representative offices and subsidiary foreign banks. The Firm’s principal operating subsidiaries outside the U.S. are J.P. Morgan Securities plc and J.P. Morgan SE (“JPMSE”), which are subsidiaries of JPMorgan Chase Bank, N.A. and are based in the United Kingdom (“U.K.”) and Germany, respectively.\"}, \"legal_name\": \"JPMorgan Chase Bank, National Association\", \"owner\": \"JPMorganChase\", \"relationship\": \"EXPLICIT_SUBSIDIARY_OF_REGISTRANT\"}, {\"alias\": \"J.P. Morgan Securities\", \"definition\": {\"attributes\": [], \"end_byte\": 2064395, \"inside_table\": false, \"span_sha256\": \"97388f5f588db903c025b2fff0e180757fd090b8e8698c06110f1290cf293af1\", \"start_byte\": 2063453, \"structure_path\": [\"html:1\", \"body:1\", \"div:263\", \"div:1\", \"div:2\"], \"tag\": \"div\", \"visible_text\": \"JPMorganChase’s principal bank subsidiary is JPMorgan Chase Bank, National Association (“JPMorgan Chase Bank, N.A.”), a national banking association with U.S. branches in 48 states and Washington, D.C. JPMorganChase’s principal non-bank subsidiary is J.P. Morgan Securities LLC (“J.P. Morgan Securities”), a U.S. broker-dealer. The bank and non-bank subsidiaries of JPMorganChase operate nationally as well as through overseas branches and subsidiaries, representative offices and subsidiary foreign banks. The Firm’s principal operating subsidiaries outside the U.S. are J.P. Morgan Securities plc and J.P. Morgan SE (“JPMSE”), which are subsidiaries of JPMorgan Chase Bank, N.A. and are based in the United Kingdom (“U.K.”) and Germany, respectively.\"}, \"legal_name\": \"J.P. Morgan Securities LLC\", \"owner\": \"JPMorganChase\", \"relationship\": \"EXPLICIT_SUBSIDIARY_OF_REGISTRANT\"}], \"source_legal_name_aliases\": [{\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 1283602, \"inside_table\": false, \"span_sha256\": \"ae5028db86909092a0529dd591624124f07ad6c444181ae75a4eb8475d8340b2\", \"start_byte\": 1282663, \"structure_path\": [\"html:1\", \"body:1\", \"div:45\", \"div:1\", \"div:2\"], \"tag\": \"div\", \"visible_text\": \"JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”, NYSE: JPM), a financial holding company incorporated under Delaware law in 1968, is a leading financial services firm based in the United States of America (“U.S.”), with operations worldwide. JPMorganChase had $4.4 trillion in assets and $362.4 billion in stockholders’ equity as of December 31, 2025. The Firm is a leader in investment banking, financial services for consumers and small businesses, commercial banking, financial transaction processing and asset management. Under the J.P. Morgan and Chase brands, the Firm serves millions of customers, predominantly in the U.S., and many of the world’s most prominent corporate, institutional and government clients globally.\"}, \"name\": \"JPMorganChase\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 1283602, \"inside_table\": false, \"span_sha256\": \"ae5028db86909092a0529dd591624124f07ad6c444181ae75a4eb8475d8340b2\", \"start_byte\": 1282663, \"structure_path\": [\"html:1\", \"body:1\", \"div:45\", \"div:1\", \"div:2\"], \"tag\": \"div\", \"visible_text\": \"JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”, NYSE: JPM), a financial holding company incorporated under Delaware law in 1968, is a leading financial services firm based in the United States of America (“U.S.”), with operations worldwide. JPMorganChase had $4.4 trillion in assets and $362.4 billion in stockholders’ equity as of December 31, 2025. The Firm is a leader in investment banking, financial services for consumers and small businesses, commercial banking, financial transaction processing and asset management. Under the J.P. Morgan and Chase brands, the Firm serves millions of customers, predominantly in the U.S., and many of the world’s most prominent corporate, institutional and government clients globally.\"}, \"name\": \"Firm\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 1444994, \"inside_table\": false, \"span_sha256\": \"036349a59fb9b792f414b6d367ca9b7a5fc013dba4b410b770efb290c6247fe1\", \"start_byte\": 1444075, \"structure_path\": [\"html:1\", \"body:1\", \"div:99\", \"div:3\", \"div:2\"], \"tag\": \"div\", \"visible_text\": \"Federal Reserve rules require JPMorgan Chase & Co. (the “Parent Company”) to maintain minimum levels of unsecured external long-term debt and other loss-absorbing capacity with specific terms (“eligible LTD”) to recapitalize JPMorganChase’s operating subsidiaries if the Parent Company were to enter into a resolution either in a bankruptcy proceeding under Chapter 11 of the U.S. Bankruptcy Code, or in a receivership administered by the FDIC under Title II of the Dodd-Frank Act (“Title II”). If the Parent Company were to enter into a resolution, holders of eligible LTD, other unsecured creditors and holders of equity securities of the Parent Company will absorb the losses of the Parent Company and its subsidiaries.\"}, \"name\": \"Parent Company\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 2041882, \"inside_table\": false, \"span_sha256\": \"2cd6a197d781d76d20af9ac54a250a85a96380dadbb3595539fa65f9a2be7784\", \"start_byte\": 2040911, \"structure_path\": [\"html:1\", \"body:1\", \"div:248\"], \"tag\": \"div\", \"visible_text\": \"The following table and graph compare the five-year cumulative total return for JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”) common stock with the cumulative return of the S&P 500 Index, the KBW Bank Index and the S&P Financials Index. The S&P 500 Index is a commonly referenced equity benchmark in the United States of America (“U.S.”), consisting of leading companies from different economic sectors. The KBW Bank Index seeks to reflect the performance of banks and thrifts that are publicly traded in the U.S. and is composed of leading national money center and regional banks and thrifts. The S&P Financials Index is an index of financial companies, all of which are components of the S&P 500. The Firm is a component of all three industry indices.\"}, \"name\": \"JPMorganChase\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 2041882, \"inside_table\": false, \"span_sha256\": \"2cd6a197d781d76d20af9ac54a250a85a96380dadbb3595539fa65f9a2be7784\", \"start_byte\": 2040911, \"structure_path\": [\"html:1\", \"body:1\", \"div:248\"], \"tag\": \"div\", \"visible_text\": \"The following table and graph compare the five-year cumulative total return for JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”) common stock with the cumulative return of the S&P 500 Index, the KBW Bank Index and the S&P Financials Index. The S&P 500 Index is a commonly referenced equity benchmark in the United States of America (“U.S.”), consisting of leading companies from different economic sectors. The KBW Bank Index seeks to reflect the performance of banks and thrifts that are publicly traded in the U.S. and is composed of leading national money center and regional banks and thrifts. The S&P Financials Index is an index of financial companies, all of which are components of the S&P 500. The Firm is a component of all three industry indices.\"}, \"name\": \"Firm\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:6pt\"]], \"end_byte\": 5230790, \"inside_table\": false, \"span_sha256\": \"3c570379f6a8ceaf7afd4210664351d562e397d19932a8ba6b64d05c99632d2e\", \"start_byte\": 5229880, \"structure_path\": [\"html:1\", \"body:1\", \"div:928\", \"div:1\", \"div:1\"], \"tag\": \"div\", \"visible_text\": \"Management of JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”) is responsible for establishing and maintaining adequate internal control over financial reporting. Internal control over financial reporting is a process designed by, or under the supervision of, the Firm’s principal executive and principal financial officers, or persons performing similar functions, and effected by JPMorganChase’s Board of Directors, management and other personnel, to provide reasonable assurance regarding the reliability of financial reporting and the preparation of financial statements for external purposes in accordance with accounting principles generally accepted in the United States of America (“U.S. GAAP”).\"}, \"name\": \"JPMorganChase\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:6pt\"]], \"end_byte\": 5230790, \"inside_table\": false, \"span_sha256\": \"3c570379f6a8ceaf7afd4210664351d562e397d19932a8ba6b64d05c99632d2e\", \"start_byte\": 5229880, \"structure_path\": [\"html:1\", \"body:1\", \"div:928\", \"div:1\", \"div:1\"], \"tag\": \"div\", \"visible_text\": \"Management of JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”) is responsible for establishing and maintaining adequate internal control over financial reporting. Internal control over financial reporting is a process designed by, or under the supervision of, the Firm’s principal executive and principal financial officers, or persons performing similar functions, and effected by JPMorganChase’s Board of Directors, management and other personnel, to provide reasonable assurance regarding the reliability of financial reporting and the preparation of financial statements for external purposes in accordance with accounting principles generally accepted in the United States of America (“U.S. GAAP”).\"}, \"name\": \"Firm\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:6pt\"]], \"end_byte\": 5580397, \"inside_table\": false, \"span_sha256\": \"65fcb011d34c65a0fff6fc92ee45b331ffff0c22450b420eb4dad028c3de821c\", \"start_byte\": 5579756, \"structure_path\": [\"html:1\", \"body:1\", \"ix:continuation:2\", \"div:1\", \"div:1\", \"div:1\"], \"tag\": \"div\", \"visible_text\": \"JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”), a financial holding company incorporated under Delaware law in 1968, is a leading financial services firm based in the U.S., with operations worldwide. The Firm is a leader in investment banking, financial services for consumers and small businesses, commercial banking, financial transaction processing and asset management. Refer to Note 32 for further discussion of the Firm's reportable business segments.\"}, \"name\": \"JPMorganChase\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:6pt\"]], \"end_byte\": 5580397, \"inside_table\": false, \"span_sha256\": \"65fcb011d34c65a0fff6fc92ee45b331ffff0c22450b420eb4dad028c3de821c\", \"start_byte\": 5579756, \"structure_path\": [\"html:1\", \"body:1\", \"ix:continuation:2\", \"div:1\", \"div:1\", \"div:1\"], \"tag\": \"div\", \"visible_text\": \"JPMorgan Chase & Co. (“JPMorganChase” or the “Firm”), a financial holding company incorporated under Delaware law in 1968, is a leading financial services firm based in the U.S., with operations worldwide. The Firm is a leader in investment banking, financial services for consumers and small businesses, commercial banking, financial transaction processing and asset management. Refer to Note 32 for further discussion of the Firm's reportable business segments.\"}, \"name\": \"Firm\"}, {\"definition\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 11603741, \"inside_table\": false, \"span_sha256\": \"8051876e48fac9e646ea9b0dc28d4fb8d8fa71126558a8774e9271976b61c945\", \"start_byte\": 11602172, \"structure_path\": [\"html:1\", \"body:1\", \"div:1384\", \"ix:continuation:1\", \"div:1\", \"div:2\"], \"tag\": \"div\", \"visible_text\": \"Restrictions imposed by U.S. federal law prohibit JPMorgan Chase Bank, N.A., and its subsidiaries, from lending to JPMorgan Chase & Co. (“Parent Company”) and certain of its affiliates unless the loans are secured in specified amounts. Such secured loans provided by any banking subsidiary to the Parent Company or to any particular affiliate, together with certain other transactions with such affiliate (collectively referred to as “covered transactions”), must be made on terms and conditions that are consistent with safe and sound banking practices. In addition, unless collateralized with cash or US Government debt obligations, covered transactions are generally limited to 10% of the banking subsidiary’s total capital, as determined by the risk-based capital guidelines; the aggregate amount of covered transactions between any banking subsidiary and all of its affiliates is limited to 20% of the banking subsidiary’s total capital.\"}, \"name\": \"Parent Company\"}]}, \"metric_id\": \"A04\", \"named_role_census\": [{\"label\": {\"colspan\": 3, \"column_index\": 9, \"grid_sha256\": \"sha256:061c51e8e706592dc6d04db272f6a959c2bd61b6ad60ceccf357d8821a7814e6\", \"origin_column_index\": 9, \"origin_row_index\": 2, \"
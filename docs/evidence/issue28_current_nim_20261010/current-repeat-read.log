_byte\": 5238225, \"inside_table\": false, \"span_sha256\": \"b30f1bb75f06fb6f9e6a9634b00094f0fe8bae4f8a836ca53bed45c4fe86627a\", \"start_byte\": 5237066, \"structure_path\": [\"html:1\", \"body:1\", \"div:932\", \"div:1\", \"div:4\"], \"tag\": \"div\", \"visible_text\": \"We have audited the accompanying consolidated balance sheets of JPMorgan Chase & Co. and its subsidiaries (the “Firm”) as of December 31, 2025 and 2024, and the related consolidated statements of income, comprehensive income, changes in stockholders’ equity and cash flows for each of the three years in the period ended December 31, 2025, including the related notes (collectively referred to as the “consolidated financial statements”). We also have audited the Firm’s internal control over financial reporting as of December 31, 2025, based on criteria established in Internal Control - Integrated Framework (2013) issued by the Committee of Sponsoring Organizations of the Treadway Commission (COSO).\"}, \"entity_scope\": \"REGISTRANT_AND_SUBSIDIARIES\"}], \"selected_measure_excludes_markets\": false, \"table_introduction\": {\"attributes\": [[\"style\", \"margin-bottom:4pt\"]], \"end_byte\": 2393000, \"inside_table\": false, \"span_sha256\": \"a1af3882934019643e9c6b0079cd3d718f4aadc9398a43f118c0c3ae99919fbb\", \"start_byte\": 2392027, \"structure_path\": [\"html:1\", \"body:1\", \"div:326\", \"div:1\", \"div:2\"], \"tag\": \"div\", \"visible_text\": \"In addition to reviewing net interest income, net yield, and noninterest revenue on a managed basis, management also reviews these metrics excluding Markets, as shown below. Markets consists of CIB’s Fixed Income Markets and Equity Markets. These metrics, which exclude Markets, are non-GAAP financial measures. Management reviews these metrics to assess the performance of the Firm’s lending, investing (including asset-liability management) and deposit-raising activities, apart from any volatility associated with Markets activities. In addition, management also assesses Markets business performance on a total revenue basis as offsets may occur across revenue lines. Management believes that these measures provide investors and analysts with alternative measures to analyze the revenue trends of the Firm.\"}}], \"whole_issuer_scope_status\": \"SOURCE_WITNESSED_WHOLE_ISSUER\"}, \"source_semantics_passed\": true}, \"source_reference_ids\": [\"sha256:4f67017a22882dc5d10064779c98351e7f39dbf643519aeaa3a1fd091c893911\", \"sha256:7179ce77593c01b74f13278d25e9dab8627a864c58d35de769dc14bfdcb819ff\", \"sha256:c5ccf6cd0074d9e75c227a3c7b8a104aa996d54894d8926ca4eb1869a7c9c03d\"]}", "confidence": "", "notes": "Disclosed managed or taxable-equivalent rate; the economic relationship validates rather than replaces the disclosed rate. Measurement covers the source fiscal-year interval. Native state: PUBLISHED; reason: PASS.", "company_id": "jpmorgan_chase", "result_id": "sha256:b0cc257695b62ebdca2e14b9f733040499b171e2b6598253a161bce9d5d2db64", "record_root": "/private/tmp/issue28-current-nim-complete-ee8p63he/state/updates/A04/results/612045b237fa4c6d9067d93a2ffa47a5", "source_root": "/private/tmp/issue28-current-nim-complete-ee8p63he/source", "local_metric_status": "NO_SOURCE_CONTENT_CHANGE", "period_role": "REQUESTED_RESULT", "result_validity": "SAVED_RECORD_CHECKED_CONTENT_NOT_ACCEPTED", "source_observation_status": "NOT_CHECKED_BY_SAVED_READER", "defect_holds": "[]", "requested_in_latest_execution": "True"}]
